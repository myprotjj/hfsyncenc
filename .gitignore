# ==========================================
# CREDENTIALS & SECRETS (STRICTLY PRIVATE)
# ==========================================
env.txt
.env
.env.*
*.key
*.token
*.pem

# ==========================================
# PRIVATE VAULT MANIFEST & RUNTIME STATE
# ==========================================
upload_manifest.json
live_activity.json

# ==========================================
# MEDIA FILES & LOCAL JELLYFIN CONTENT
# ==========================================
videos_to_sync/*
!videos_to_sync/.gitkeep
test_videos/*
!test_videos/.gitkeep
jellyfin_library/*
!jellyfin_library/.gitkeep
storyboards/*
!storyboards/.gitkeep
archive/*
!archive/.gitkeep
*.mp4
*.m4a
*.mkv
*.avi
*.mov
*.enc
*.strm
*.nfo
*.srt
*.vtt
*.jpg
*.jpeg
*.png
*.webp

