            aliasActionInProgress = true;
            try {{
                const resp = await fetch('/api/aliases/add', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ key: editingKey, alias: newName }})
                }});
