        function buildTree(files) {{
            const root = {{ name: "root", type: "folder", children: {{}} }};

            files.forEach(f => {{
                const parts = f.key.split('/');
                let curr = root;

                for (let i = 0; i < parts.length; i++) {{
                    const part = parts[i];
                    const isLast = (i === parts.length - 1);

                    if (isLast) {{
                        curr.children[part] = {{
                            name: part,
                            type: "file",
                            data: f
                        }};
                    }} else {{
                        if (!curr.children[part]) {{
                            curr.children[part] = {{
                                name: part,
                                type: "folder",
                                children: {{}}
                            }};
                        }}
                        curr = curr.children[part];
                    }}
                }}
            }});

            return root;
        }}

