<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HFSYNC - Encrypted Media Vault</title>
    <link rel="stylesheet" href="/static/css/staging.css">
    <script src="/static/js/staging.js" defer></script>
    <style>
        :root {{
            --bg: #090d16;
            --panel: #111827;
            --panel-border: #1f2937;
            --primary: #38bdf8;
            --primary-hover: #0284c7;
            --danger: #ef4444;
            --danger-hover: #dc2626;
            --text: #f9fafb;
            --text-muted: #9ca3af;
            --accent: #10b981;
            --purple: #a855f7;
            --amber: #f59e0b;
        }}
        * {{ box-sizing: border-box; }}
        body {{
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 24px;
        }}
        .container {{ max-width: 1140px; margin: 0 auto; }}
        header, .vault-header {{
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--panel-border);
            padding: 4px 0 12px 0;
            margin-bottom: 10px;
            flex-wrap: wrap;
            gap: 12px;
        }}
        .vault-brand-cluster {{
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }}
        .vault-brand-title {{
            margin: 0;
            font-size: 1.32rem;
            color: var(--primary);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 800;
            letter-spacing: -0.3px;
        }}
        .vault-actions-cluster {{
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }}
        .jellyfin-sync-pill {{
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 5px 12px;
            background: rgba(15, 23, 42, 0.75);
            border: 1px solid rgba(56, 189, 248, 0.35);
            border-radius: 9999px;
            cursor: pointer;
            font-size: 0.82rem;
            color: #e2e8f0;
            transition: all 0.2s ease;
            user-select: none;
        }}
        .jellyfin-sync-pill:hover {{
            background: rgba(56, 189, 248, 0.15);
            border-color: rgba(56, 189, 248, 0.6);
            transform: translateY(-1px);
        }}
        .jellyfin-sync-badge {{
            padding: 2px 7px;
            border-radius: 9999px;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
        }}
        .jellyfin-sync-badge.is-on {{
            background: rgba(16, 185, 129, 0.25);
            color: #34d399;
            border: 1px solid rgba(52, 211, 153, 0.5);
            box-shadow: 0 0 8px rgba(52, 211, 153, 0.25);
        }}
        .jellyfin-sync-badge.is-off {{
            background: rgba(100, 116, 139, 0.25);
            color: #94a3b8;
            border: 1px solid rgba(148, 163, 184, 0.3);
        }}

        /* Status Pills (Always-On-Top Indicators) */
        .status-pill {{
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 3px 10px;
            border-radius: 9999px;
            font-size: 0.74rem;
            font-weight: 600;
            letter-spacing: 0.2px;
            transition: all 0.25s ease;
            white-space: nowrap;
        }}
        .status-pill.status-online {{
            background: rgba(16, 185, 129, 0.14);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #34d399;
        }}
        .status-pill.status-offline {{
            background: rgba(239, 68, 68, 0.2);
            border: 1px solid rgba(239, 68, 68, 0.6);
            color: #fca5a5;
            animation: pulse-alert 1.2s infinite alternate;
        }}
        .status-pill.status-idle {{
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #6ee7b7;
        }}
        .status-pill.status-active {{
            background: rgba(56, 189, 248, 0.2);
            border: 1px solid rgba(56, 189, 248, 0.55);
            color: #7dd3fc;
            animation: pulse-sync 1.5s infinite alternate;
        }}
        .status-pill.status-attention {{
            background: rgba(245, 158, 11, 0.2);
            border: 1px solid rgba(245, 158, 11, 0.6);
            color: #fcd34d;
            animation: pulse-alert 1.2s infinite alternate;
        }}
        @keyframes pulse-sync {{
            from {{ box-shadow: 0 0 4px rgba(56, 189, 248, 0.3); }}
            to {{ box-shadow: 0 0 12px rgba(56, 189, 248, 0.75); }}
        }}
        @keyframes pulse-alert {{
            from {{ box-shadow: 0 0 4px rgba(239, 68, 68, 0.3); }}
            to {{ box-shadow: 0 0 14px rgba(239, 68, 68, 0.85); transform: scale(1.02); }}
        }}
        .pill-dot {{
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: inline-block;
        }}
        .status-online .pill-dot, .status-idle .pill-dot {{ background: #10b981; box-shadow: 0 0 6px #10b981; }}
        .status-offline .pill-dot {{ background: #ef4444; box-shadow: 0 0 6px #ef4444; }}
        .status-active .pill-dot {{ background: #38bdf8; box-shadow: 0 0 6px #38bdf8; }}
        .status-attention .pill-dot {{ background: #f59e0b; box-shadow: 0 0 6px #f59e0b; }}

        /* Unified Metrics & Actions Toolbar (Single cohesive line, zero duplicates) */
        .vault-unified-bar {{
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 12px;
            padding: 7px 14px;
            background: rgba(15, 23, 42, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            backdrop-filter: blur(10px);
        }}
        .unified-metrics-cluster {{
            display: inline-flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            flex: 1;
            min-width: 280px;
        }}
        .unified-actions-cluster {{
            display: inline-flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }}
        .metric-chip {{
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.78rem;
            color: #9ca3af;
            padding: 2px 7px;
            border-radius: 6px;
            transition: background 0.15s;
        }}
        .metric-chip.clickable {{
            cursor: pointer;
        }}
        .metric-chip.clickable:hover {{
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
        }}
        .metric-val {{
            font-weight: 700;
            color: #f3f4f6;
            font-size: 0.86rem;
        }}
        .metric-divider {{
            color: rgba(255, 255, 255, 0.15);
            font-size: 0.8rem;
        }}

        /* Modern Flat Minimal Tree Folder Tags Cluster */
        .folder-tags-cluster {{
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-left: 8px;
            flex-wrap: wrap;
        }}
        .tree-tag-chip {{
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 1px 6px;
            background: rgba(168, 85, 247, 0.08);
            border: 1px solid rgba(168, 85, 247, 0.2);
            border-radius: 4px;
            color: #c084fc;
            font-size: 0.71rem;
            font-weight: 500;
            transition: all 0.15s ease;
            user-select: none;
        }}
        .tree-tag-chip:hover {{
            background: rgba(168, 85, 247, 0.16);
            border-color: rgba(168, 85, 247, 0.4);
            color: #e9d5ff;
        }}
        .tree-tag-edit, .tree-tag-remove {{
            cursor: pointer;
            opacity: 0.35;
            transition: opacity 0.15s ease, color 0.15s ease;
            font-size: 0.75rem;
            padding: 0 1px;
            border-radius: 2px;
            line-height: 1;
        }}
        .tree-tag-chip:hover .tree-tag-edit,
        .tree-tag-chip:hover .tree-tag-remove {{
            opacity: 0.85;
        }}
        .tree-tag-edit:hover {{
            opacity: 1;
            color: #38bdf8;
        }}
        .tree-tag-remove:hover {{
            opacity: 1;
            color: #f87171;
        }}
        .btn-tree-add-tag {{
            background: transparent;
            border: 1px dashed rgba(255, 255, 255, 0.16);
            border-radius: 4px;
            color: #94a3b8;
            font-size: 0.68rem;
            font-weight: 500;
            padding: 1px 6px;
            cursor: pointer;
            transition: all 0.15s ease;
            line-height: 1.3;
        }}
        .btn-tree-add-tag:hover {{
            background: rgba(56, 189, 248, 0.08);
            border-color: #38bdf8;
            color: #38bdf8;
        }}

        /* Video Card Quick-Add Button & Popover */
        .btn-card-quick-add {{
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 1px 7px;
            font-size: 0.65rem;
            font-weight: 600;
            border-radius: 9999px;
            border: 1px dashed rgba(168, 85, 247, 0.45);
            background: rgba(168, 85, 247, 0.08);
            color: #d8b4fe;
            cursor: pointer;
            transition: all 0.15s ease;
            vertical-align: middle;
            white-space: nowrap;
            user-select: none;
            line-height: 1.4;
        }}
        .btn-card-quick-add:hover {{
            background: rgba(168, 85, 247, 0.24);
            border-color: #c084fc;
            color: #f5d0fe;
            transform: translateY(-1px);
            box-shadow: 0 0 8px rgba(168, 85, 247, 0.35);
        }}
        .card-quick-add-popover {{
            position: fixed;
            z-index: 99999;
            width: 320px;
            max-height: 440px;
            background: rgba(15, 23, 42, 0.98);
            border: 1px solid rgba(168, 85, 247, 0.45);
            border-radius: 10px;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.8), 0 0 24px rgba(168, 85, 247, 0.22);
            backdrop-filter: blur(16px);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            animation: quickAddFadeIn 0.15s ease-out;
            font-family: inherit;
        }}
        @keyframes quickAddFadeIn {{
            from {{ opacity: 0; transform: translateY(-4px) scale(0.98); }}
            to {{ opacity: 1; transform: translateY(0) scale(1); }}
        }}
        .quick-add-header {{
            padding: 10px 12px 8px 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.02);
        }}
        .quick-add-title {{
            font-size: 0.82rem;
            font-weight: 600;
            color: #e9d5ff;
            display: flex;
            align-items: center;
            gap: 6px;
        }}
        .quick-add-close {{
            background: transparent;
            border: none;
            color: #9ca3af;
            font-size: 1.15rem;
            line-height: 1;
            cursor: pointer;
            padding: 0 4px;
            border-radius: 4px;
            transition: color 0.12s, background 0.12s;
        }}
        .quick-add-close:hover {{
            color: #f3f4f6;
            background: rgba(255, 255, 255, 0.1);
        }}
        .quick-add-input-box {{
            padding: 8px 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            background: rgba(0, 0, 0, 0.15);
        }}
        .quick-add-input {{
            width: 100%;
            box-sizing: border-box;
            padding: 6px 10px;
            font-size: 0.8rem;
            border-radius: 6px;
            border: 1px solid rgba(168, 85, 247, 0.35);
            background: rgba(15, 23, 42, 0.85);
            color: #f8fafc;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }}
        .quick-add-input:focus {{
            border-color: #c084fc;
            box-shadow: 0 0 10px rgba(168, 85, 247, 0.35);
        }}
        .quick-add-filter-tabs {{
            display: flex;
            gap: 4px;
            margin-top: 6px;
        }}
        .quick-add-tab {{
            padding: 2px 7px;
            font-size: 0.70rem;
            border-radius: 4px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.04);
            color: #94a3b8;
            cursor: pointer;
            transition: all 0.12s;
        }}
        .quick-add-tab:hover {{
            background: rgba(255, 255, 255, 0.08);
            color: #e2e8f0;
        }}
        .quick-add-tab.active {{
            background: rgba(168, 85, 247, 0.25);
            border-color: #a855f7;
            color: #f3e8ff;
            font-weight: 600;
        }}
        .quick-add-applied-section {{
            padding: 6px 10px;
            background: rgba(0, 0, 0, 0.25);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            font-size: 0.72rem;
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            max-height: 80px;
            overflow-y: auto;
        }}
        .quick-add-applied-chip {{
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 1px 6px;
            border-radius: 4px;
            font-size: 0.68rem;
        }}
        .quick-add-applied-chip.is-tag {{
            background: rgba(56, 189, 248, 0.15);
            border: 1px solid rgba(56, 189, 248, 0.35);
            color: #7dd3fc;
        }}
        .quick-add-applied-chip.is-genre {{
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #6ee7b7;
        }}
        .quick-add-chip-del {{
            cursor: pointer;
            color: #f87171;
            font-weight: bold;
            margin-left: 2px;
            font-size: 0.8rem;
            line-height: 1;
        }}
        .quick-add-chip-del:hover {{
            color: #ef4444;
        }}
        .quick-add-list {{
            flex: 1;
            overflow-y: auto;
            padding: 6px;
            display: flex;
            flex-direction: column;
            gap: 3px;
            max-height: 230px;
        }}
        .quick-add-item {{
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 5px 8px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.76rem;
            color: #e2e8f0;
            transition: background 0.12s;
            user-select: none;
        }}
        .quick-add-item:hover {{
            background: rgba(168, 85, 247, 0.22);
            color: #ffffff;
        }}
        .quick-add-item-name {{
            display: flex;
            align-items: center;
            gap: 6px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }}
        .quick-add-item-type {{
            font-size: 0.65rem;
            padding: 1px 5px;
            border-radius: 3px;
            font-weight: 600;
            text-transform: uppercase;
        }}
        .quick-add-item-type.tag-type {{
            background: rgba(56, 189, 248, 0.2);
            color: #38bdf8;
        }}
        .quick-add-item-type.cat-type {{
            background: rgba(16, 185, 129, 0.2);
            color: #34d399;
        }}
        .quick-add-create-btn {{
            display: flex;
            align-items: center;
            gap: 6px;
            width: 100%;
            text-align: left;
            padding: 6px 8px;
            border-radius: 6px;
            border: 1px dashed rgba(168, 85, 247, 0.4);
            background: rgba(168, 85, 247, 0.1);
            color: #d8b4fe;
            font-size: 0.74rem;
            cursor: pointer;
            margin-bottom: 4px;
            transition: all 0.12s;
        }}
        .quick-add-create-btn:hover {{
            background: rgba(168, 85, 247, 0.28);
            border-color: #c084fc;
            color: #ffffff;
        }}

        .pill-del-trigger {{
            font-size: 0.72rem;
            margin-left: 2px;
            cursor: pointer;
            opacity: 0.65;
            color: #f87171;
            font-weight: bold;
            transition: opacity 0.15s, color 0.15s;
            padding: 0 2px;
            border-radius: 2px;
            display: inline-flex;
            align-items: center;
            line-height: 1;
        }}
        .pill-del-trigger:hover {{
            opacity: 1;
            color: #ef4444;
            background: rgba(239, 68, 68, 0.2);
        }}
        .btn-tag-del-mini {{
            background: transparent;
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #f87171;
            border-radius: 4px;
            padding: 1px 5px;
            font-size: 0.68rem;
            cursor: pointer;
            transition: all 0.12s;
            line-height: 1.2;
        }}
        .btn-tag-del-mini:hover {{
            background: rgba(239, 68, 68, 0.2);
            border-color: #ef4444;
            color: #ffffff;
        }}
        .quick-add-item-purge {{
            cursor: pointer;
            color: #f87171;
            font-size: 0.85rem;
            font-weight: bold;
            padding: 0 4px;
            border-radius: 3px;
            transition: background 0.12s, color 0.12s;
            line-height: 1;
        }}
        .quick-add-item-purge:hover {{
            background: rgba(239, 68, 68, 0.25);
            color: #ffffff;
        }}

        /* Hide Tags Mode */
        .cards-hide-tags .video-card:not(.is-expanded) .video-card-badges,
        .cards-hide-tags .file-row:not(.is-expanded) .row-badges {{
            display: none !important;
        }}
        .video-card.is-expanded .video-card-badges {{
            display: flex !important;
            padding-top: 6px;
            border-top: 1px dashed rgba(255, 255, 255, 0.1);
            margin-top: 6px;
        }}

        /* Per-tag hide system (Hide any tag from all cards, visible on expand, filterable) */
        .video-card:not(.is-expanded) .is-hidden-tag,
        .file-row:not(.is-expanded) .is-hidden-tag {{
            display: none !important;
        }}
        .video-card.is-expanded .is-hidden-tag,
        .file-row.is-expanded .is-hidden-tag {{
            display: inline-flex !important;
            opacity: 0.72;
            border: 1px dashed rgba(245, 158, 11, 0.5) !important;
            background: rgba(245, 158, 11, 0.08) !important;
        }}
        .pill-tag-edit {{
            font-size: 0.68rem;
            margin-left: 3px;
            margin-right: 1px;
            cursor: pointer;
            opacity: 0.72;
            color: #94a3b8;
            transition: all 0.15s ease;
            padding: 0 2px;
            border-radius: 2px;
            display: inline-flex;
            align-items: center;
            line-height: 1;
        }}
        .meta-pill:hover .pill-tag-edit {{
            opacity: 1;
            color: #38bdf8;
        }}
        .pill-tag-edit:hover {{
            color: #ffffff !important;
            background: rgba(56, 189, 248, 0.45);
            transform: scale(1.25);
        }}
        .pill-hide-trigger {{
            font-size: 0.65rem;
            margin-left: 2px;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.15s, transform 0.15s;
            padding: 0 2px;
            border-radius: 2px;
        }}
        .meta-pill:hover .pill-hide-trigger,
        .is-hidden-tag .pill-hide-trigger {{
            opacity: 0.9;
        }}
        .pill-hide-trigger:hover {{
            opacity: 1;
            transform: scale(1.25);
        }}
        .btn-tag-hide-toggle {{
            font-size: 0.68rem;
            padding: 2px 7px;
            border-radius: 4px;
            border: 1px solid rgba(255, 255, 255, 0.14);
            background: rgba(255, 255, 255, 0.06);
            color: #9ca3af;
            cursor: pointer;
            transition: all 0.15s ease;
            white-space: nowrap;
        }}
        .btn-tag-hide-toggle:hover {{
            border-color: rgba(56, 189, 248, 0.5);
            color: #38bdf8;
            background: rgba(56, 189, 248, 0.15);
        }}
        .btn-tag-hide-toggle.is-hidden {{
            border-color: rgba(245, 158, 11, 0.5);
            color: #fbbf24;
            background: rgba(245, 158, 11, 0.15);
        }}
        .popover-item {{
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            padding: 3px 6px;
            border-radius: 4px;
        }}
        .popover-item-left {{
            display: flex;
            align-items: center;
            gap: 7px;
            cursor: pointer;
            flex: 1;
            min-width: 0;
        }}
        .popover-item.is-tag-hidden {{
            background: rgba(245, 158, 11, 0.05);
        }}
        .popover-hidden-badge {{
            font-size: 0.72rem;
            padding: 2px 8px;
            background: rgba(245, 158, 11, 0.18);
            border: 1px solid rgba(245, 158, 11, 0.4);
            color: #fbbf24;
            border-radius: 4px;
            cursor: pointer;
            white-space: nowrap;
        }}
        .popover-hidden-badge:hover {{
            background: rgba(245, 158, 11, 0.3);
            color: #fff;
        }}

        /* Dedicated Screens Hover Overlay (Zero conflict with storyboard scrubbing!) */
        .thumb-screens-overlay {{
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #0b0f19;
            background-size: contain;
            background-position: center;
            background-repeat: no-repeat;
            z-index: 4;
            display: none;
            pointer-events: none;
            border-radius: 6px;
        }}
        .sticky-live-alert-cluster {{
            display: inline-flex;
            align-items: center;
            margin-left: auto;
            flex-shrink: 0;
        }}
        
        .skipped-banner {{
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(245, 158, 11, 0.35);
            border-radius: 10px;
            padding: 14px 18px;
            margin-bottom: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }}
        .skipped-banner-left {{
            display: flex;
            align-items: center;
            gap: 12px;
        }}
        .skipped-card {{
            background: #090d16;
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }}
        .skipped-name {{
            font-weight: 600;
            color: #f3f4f6;
            font-size: 0.9rem;
        }}
        .skipped-reason {{
            color: #f59e0b;
            font-size: 0.78rem;
            margin-top: 3px;
        }}

        /* Advanced Modern YouTube-Style Video Player */
        .yt-player-box {{
            background: #0a0a0c;
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 24px;
            box-shadow: 0 16px 40px rgba(0,0,0,0.85);
            border: 1px solid rgba(255,255,255,0.08);
            display: none;
            transition: max-width 0.3s ease, margin 0.3s ease;
        }}
        .yt-player-box.theater-mode {{
            max-width: 100% !important;
            border-radius: 0;
            margin-left: -20px;
            margin-right: -20px;
            border-left: none;
            border-right: none;
        }}
        .yt-container {{
            position: relative;
            width: 100%;
            background: #000;
            outline: none;
            aspect-ratio: 16 / 9;
            max-height: 75vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            user-select: none;
        }}
        .yt-container.hide-cursor {{
            cursor: none;
        }}
        .yt-container video {{
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }}

        /* Top Overlay */
        .yt-top-overlay {{
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            padding: 14px 18px;
            background: linear-gradient(to bottom, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 25;
            transition: opacity 0.25s ease;
            pointer-events: auto;
        }}
        .yt-top-title-group {{
            display: flex;
            align-items: center;
            gap: 12px;
            overflow: hidden;
        }}
        .yt-security-badge {{
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #34d399;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            flex-shrink: 0;
        }}
        .yt-live-dot {{
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 8px #10b981;
        }}
        .yt-video-title {{
            color: #f3f4f6;
            font-size: 0.95rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-shadow: 0 1px 4px rgba(0,0,0,0.8);
        }}
        .yt-top-actions {{
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }}

        /* Center Animation Feedback & Spinner */
        .yt-center-feedback {{
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.6);
            background: rgba(0, 0, 0, 0.68);
            color: #fff;
            width: 76px;
            height: 76px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            pointer-events: none;
            opacity: 0;
            transition: transform 0.25s cubic-bezier(0.18, 0.89, 0.32, 1.28), opacity 0.25s ease;
            z-index: 20;
            backdrop-filter: blur(4px);
        }}
        .yt-center-feedback.show {{
            transform: translate(-50%, -50%) scale(1.15);
            opacity: 1;
        }}
        .yt-spinner {{
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 18;
            pointer-events: none;
        }}
        .yt-spinner-ring {{
            width: 52px;
            height: 52px;
            border: 4px solid rgba(255, 255, 255, 0.2);
            border-top-color: #ff0000;
            border-radius: 50%;
            animation: yt-spin 0.8s linear infinite;
        }}
        @keyframes yt-spin {{
            to {{ transform: rotate(360deg); }}
        }}

        /* Bottom Controls Overlay */
        .yt-controls-overlay {{
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.6) 60%, transparent 100%);
            padding: 8px 16px 10px 16px;
            z-index: 25;
            transition: opacity 0.25s ease;
            pointer-events: auto;
        }}
        .yt-container.controls-hidden .yt-top-overlay,
        .yt-container.controls-hidden .yt-controls-overlay {{
            opacity: 0;
            pointer-events: none;
        }}

        /* Scrub / Progress Bar */
        .yt-scrub-container {{
            position: relative;
            width: 100%;
            height: 16px;
            display: flex;
            align-items: center;
            cursor: pointer;
            margin-bottom: 6px;
        }}
        .yt-scrub-track {{
            position: relative;
            width: 100%;
            height: 4px;
            background: rgba(255, 255, 255, 0.22);
            border-radius: 2px;
            transition: height 0.15s ease;
        }}
        .yt-scrub-container:hover .yt-scrub-track {{
            height: 6px;
        }}
        .yt-scrub-buffered {{
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 0%;
            background: rgba(255, 255, 255, 0.45);
            border-radius: 2px;
            pointer-events: none;
        }}
        .yt-scrub-progress {{
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 0%;
            background: #ff0000;
            border-radius: 2px;
            pointer-events: none;
        }}
        .yt-scrub-handle {{
            position: absolute;
            right: -6px;
            top: 50%;
            transform: translateY(-50%) scale(0);
            width: 13px;
            height: 13px;
            background: #ff0000;
            border-radius: 50%;
            transition: transform 0.15s ease;
            box-shadow: 0 0 6px rgba(255,0,0,0.7);
        }}
        .yt-scrub-container:hover .yt-scrub-handle,
        .yt-scrub-container.is-dragging .yt-scrub-handle {{
            transform: translateY(-50%) scale(1);
        }}
        .yt-scrub-tooltip {{
            position: absolute;
            bottom: 26px;
            transform: translateX(-50%);
            background: rgba(14, 14, 18, 0.96);
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.85);
            border: 1px solid rgba(255,255,255,0.18);
            display: none;
            pointer-events: none;
            overflow: hidden;
            text-align: center;
            z-index: 50;
            transition: opacity 0.1s ease;
        }}
        .yt-thumb-preview {{
            width: 200px;
            height: 112px;
            background-color: #000;
            background-repeat: no-repeat;
            display: block;
            image-rendering: -webkit-optimize-contrast;
            image-rendering: high-quality;
        }}
        .yt-tooltip-time {{
            padding: 4px 8px;
            font-size: 0.76rem;
            font-weight: 700;
            color: #f3f4f6;
            background: rgba(0, 0, 0, 0.7);
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            letter-spacing: 0.5px;
        }}

        /* Controls Row */
        .yt-controls-row {{
            display: flex;
            justify-content: space-between;
            align-items: center;
        }}
        .yt-controls-left, .yt-controls-right {{
            display: flex;
            align-items: center;
            gap: 6px;
        }}
        .yt-btn {{
            background: transparent;
            border: none;
            color: #e5e7eb;
            cursor: pointer;
            padding: 6px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: color 0.15s, transform 0.1s, background 0.15s;
            outline: none;
        }}
        .yt-btn:hover {{
            color: #fff;
            background: rgba(255,255,255,0.12);
        }}
        .yt-btn:active {{
            transform: scale(0.92);
        }}
        .yt-btn-speed {{
            font-size: 0.82rem;
            font-weight: 600;
            padding: 4px 8px;
            min-width: 36px;
        }}
        .yt-btn-close {{
            font-size: 1.3rem;
            line-height: 1;
            padding: 2px 8px;
            color: #9ca3af;
        }}
        .yt-btn-close:hover {{
            color: #ef4444;
            background: rgba(239, 68, 68, 0.15);
        }}

        /* Volume Slider */
        .yt-volume-group {{
            display: flex;
            align-items: center;
        }}
        .yt-volume-slider-wrap {{
            width: 0;
            overflow: hidden;
            transition: width 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
        }}
        .yt-volume-group:hover .yt-volume-slider-wrap,
        .yt-volume-slider-wrap:focus-within {{
            width: 64px;
            margin-right: 8px;
        }}
        .yt-volume-slider {{
            width: 60px;
            height: 4px;
            -webkit-appearance: none;
            appearance: none;
            background: rgba(255,255,255,0.3);
            border-radius: 2px;
            outline: none;
            cursor: pointer;
        }}
        .yt-volume-slider::-webkit-slider-thumb {{
            -webkit-appearance: none;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #fff;
            cursor: pointer;
        }}
        .yt-time-display {{
            font-size: 0.8rem;
            color: #d1d5db;
            font-weight: 500;
            margin-left: 6px;
            letter-spacing: 0.3px;
        }}

        /* Speed Popover Menu */
        .yt-speed-container {{
            position: relative;
        }}
        .yt-speed-menu {{
            position: absolute;
            bottom: 42px;
            right: 0;
            background: rgba(20, 20, 24, 0.96);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 10px;
            padding: 6px 0;
            width: 140px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            z-index: 40;
        }}
        .yt-speed-title {{
            padding: 6px 14px;
            font-size: 0.72rem;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            margin-bottom: 4px;
        }}
        .yt-speed-option {{
            padding: 6px 14px;
            font-size: 0.82rem;
            color: #e5e7eb;
            cursor: pointer;
            transition: background 0.15s, color 0.15s;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }}
        .yt-speed-option:hover {{
            background: rgba(255,255,255,0.1);
            color: #fff;
        }}
        .yt-speed-option.active {{
            color: #ff0000;
            font-weight: 700;
        }}
        .yt-speed-option.active::after {{
            content: "✓";
            font-size: 0.8rem;
        }}

        /* Stats for Nerds */
        .yt-stats-panel {{
            position: absolute;
            top: 56px;
            left: 18px;
            background: rgba(10, 10, 14, 0.88);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 8px;
            padding: 10px 14px;
            color: #e5e7eb;
            font-size: 0.75rem;
            font-family: monospace;
            z-index: 35;
            max-width: 360px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.7);
        }}
        .yt-stats-header {{
            display: flex;
            justify-content: space-between;
            font-weight: 700;
            color: #38bdf8;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 4px;
            margin-bottom: 8px;
        }}
        .yt-stats-grid {{
            display: grid;
            grid-template-columns: 130px 1fr;
            row-gap: 4px;
            column-gap: 8px;
        }}

        /* Auto-Activating Floating Popup Mini-Player */
        .yt-container.is-floating-mini {{
            position: fixed !important;
            bottom: 24px;
            right: 24px;
            width: 480px;
            max-width: calc(100vw - 24px) !important;
            aspect-ratio: 16 / 9 !important;
            height: auto !important;
            max-height: 270px;
            z-index: 99999 !important;
            border-radius: 12px !important;
            box-shadow: 0 16px 45px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.16) !important;
            overflow: hidden !important;
            animation: yt-float-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
            backdrop-filter: blur(8px) !important;
            touch-action: none;
        }}
        .yt-container.is-floating-mini.mini-size-s {{
            width: 360px !important;
            max-height: 202px !important;
        }}
        .yt-container.is-floating-mini.mini-size-m {{
            width: 500px !important;
            max-height: 281px !important;
        }}
        .yt-container.is-floating-mini.mini-size-l {{
            width: 680px !important;
            max-height: 382px !important;
        }}
        .yt-container.is-floating-mini .yt-top-overlay {{
            cursor: move;
            user-select: none;
        }}
        .yt-mini-size-controls {{
            display: none;
        }}
        .yt-container.is-floating-mini .yt-mini-size-controls {{
            display: inline-flex !important;
            align-items: center;
            gap: 2px;
            background: rgba(0, 0, 0, 0.45);
            border-radius: 4px;
            padding: 1px 3px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            margin-right: 4px;
        }}
        .yt-mini-size-btn {{
            background: transparent;
            border: none;
            color: #94a3b8;
            font-size: 0.68rem;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 3px;
            cursor: pointer;
            transition: all 0.15s ease;
        }}
        .yt-mini-size-btn:hover {{
            color: #fff;
            background: rgba(255, 255, 255, 0.2);
        }}
        .yt-mini-size-btn.active {{
            color: #040711;
            background: var(--primary);
            box-shadow: 0 0 6px rgba(56, 189, 248, 0.6);
        }}
        @keyframes yt-float-in {{
            from {{ transform: translateY(30px) scale(0.92); opacity: 0; }}
            to {{ transform: translateY(0) scale(1); opacity: 1; }}
        }}
        .yt-container.is-floating-mini .yt-top-overlay {{
            padding: 8px 12px !important;
        }}
        .yt-container.is-floating-mini .yt-security-badge {{
            display: none !important;
        }}
        .yt-container.is-floating-mini .yt-video-title {{
            font-size: 0.8rem !important;
            max-width: 190px !important;
        }}
        .yt-container.is-floating-mini .yt-controls-overlay {{
            padding: 4px 10px 8px 10px !important;
        }}
        .yt-container.is-floating-mini .yt-speed-container,
        .yt-container.is-floating-mini .yt-sub-container,
        .yt-container.is-floating-mini button[title*="Stats"],
        .yt-container.is-floating-mini button[title*="Theater"] {{
            display: none !important;
        }}
        .yt-container.is-floating-mini .yt-volume-group {{
            display: inline-flex !important;
            align-items: center;
            cursor: pointer;
        }}
        .yt-container.is-floating-mini .yt-volume-slider-wrap {{
            width: 0;
            overflow: hidden;
            transition: width 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }}
        .yt-container.is-floating-mini .yt-volume-group:hover .yt-volume-slider-wrap,
        .yt-container.is-floating-mini .yt-volume-slider-wrap:focus-within {{
            width: 48px !important;
        }}
        .yt-container.is-floating-mini .yt-volume-slider {{
            width: 48px !important;
        }}
        .yt-container.is-floating-mini .yt-btn {{
            padding: 4px !important;
        }}
        .yt-container.is-floating-mini .yt-time-display {{
            font-size: 0.72rem !important;
        }}
        .yt-mini-expand-btn {{
            display: none;
        }}
        .yt-container.is-floating-mini .yt-mini-expand-btn {{
            display: inline-flex !important;
            background: rgba(255, 255, 255, 0.15) !important;
            border-radius: 4px !important;
            color: #fff !important;
        }}
        .yt-container.is-floating-mini .yt-mini-expand-btn:hover {{
            background: var(--primary) !important;
            color: #040711 !important;
            box-shadow: 0 0 8px rgba(56, 189, 248, 0.6) !important;
        }}

        .sticky-filter-bar {{
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(11, 15, 25, 0.94);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            padding: 12px 0 8px 0;
            margin-bottom: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
            transition: all 0.2s ease;
        }}
        .sticky-filter-bar .toolbar {{
            margin-bottom: 0;
        }}
        .sticky-filter-bar .active-chips-bar {{
            margin-top: 8px;
            margin-bottom: 0;
        }}
        .filter-summary-count {{
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            background: rgba(99, 102, 241, 0.18);
            border: 1px solid rgba(99, 102, 241, 0.45);
            border-radius: 9999px;
            color: #a5b4fc;
            font-size: 0.82rem;
            font-weight: 600;
            white-space: nowrap;
        }}
        .filter-count-badge {{
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            background: rgba(99, 102, 241, 0.25);
            border: 1px solid rgba(99, 102, 241, 0.5);
            border-radius: 9999px;
            color: #c7d2fe;
            font-size: 0.76rem;
            font-weight: 700;
            margin-right: 6px;
        }}
        .folder-count.is-matching-filtered {{
            background: rgba(99, 102, 241, 0.25) !important;
            color: #c7d2fe !important;
            border: 1px solid rgba(99, 102, 241, 0.5) !important;
            font-weight: 700 !important;
        }}

        .toolbar {{
            display: flex;
            gap: 10px;
            align-items: center;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }}
        .search-input {{
            flex: 1;
            min-width: 240px;
            padding: 10px 14px;
            background: var(--panel);
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            color: #fff;
            font-size: 0.92rem;
            outline: none;
        }}
        .search-input:focus {{ border-color: var(--primary); }}
        
        .filter-select {{
            padding: 10px 14px;
            background: var(--panel);
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            color: #f3f4f6;
            font-size: 0.9rem;
            outline: none;
            cursor: pointer;
        }}
        .filter-select:focus {{ border-color: var(--primary); }}

        .tool-btn {{
            padding: 10px 14px;
            background: var(--panel);
            border: 1px solid var(--panel-border);
            color: var(--text-muted);
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.88rem;
            font-weight: 500;
            transition: all 0.2s;
            white-space: nowrap;
        }}
        .tool-btn:hover {{ color: #fff; border-color: #4b5563; }}

        /* Tree view structure */
        .tree-container {{
            background: var(--panel);
            border: 1px solid var(--panel-border);
            border-radius: 10px;
            padding: 16px;
            min-height: 200px;
            overflow-anchor: auto;
        }}
        .tree-node {{ margin-left: 20px; }}
        .folder-header {{
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 6px 12px;
            min-height: 38px;
            background: rgba(15, 23, 42, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            font-weight: 600;
            color: #e2e8f0;
            transition: background 0.15s ease, border-color 0.15s ease;
        }}
        .folder-header:hover {{
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.09);
        }}
        .folder-left {{
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            user-select: none;
            flex: 1;
            flex-wrap: wrap;
        }}
        .folder-actions {{
            display: flex;
            gap: 4px;
            align-items: center;
            flex-shrink: 0;
        }}
        .btn-sm {{
            padding: 4px 10px;
            font-size: 0.78rem;
        }}
        .folder-icon {{ color: #fbbf24; font-size: 1rem; display: inline-flex; align-items: center; }}
        .folder-arrow {{
            font-size: 0.72rem;
            color: #64748b;
            width: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s ease, color 0.15s ease;
        }}
        .folder-header:hover .folder-arrow {{ color: #94a3b8; }}
        .folder-arrow.open {{ transform: rotate(90deg); color: #38bdf8; }}
        .folder-count {{
            font-size: 0.72rem;
            font-weight: 500;
            color: #94a3b8;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 9999px;
            padding: 1px 7px;
            margin-left: 6px;
            white-space: nowrap;
        }}
        .folder-children {{
            margin-left: 10px;
            border-left: 1px solid rgba(255, 255, 255, 0.06);
            padding-left: 10px;
            margin-top: 4px;
        }}
        .folder-children.collapsed {{ display: none; }}
        .is-filter-hidden {{ display: none !important; }}
        .video-card, .file-row {{ transition: opacity 0.15s ease; }}

        .folder-group {{
            margin-bottom: 6px;
            transition: all 0.25s ease;
        }}
        .folder-group.is-playing-group {{
            border: 1px solid rgba(56, 189, 248, 0.4);
            background: rgba(56, 189, 248, 0.03);
            border-radius: 8px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
            margin-bottom: 14px;
        }}
        .folder-group.is-playing-group > .folder-header {{
            background: rgba(56, 189, 248, 0.09);
            border-bottom: 1px solid rgba(56, 189, 248, 0.25);
            border-radius: 7px 7px 0 0;
        }}
        .folder-playing-badge {{
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: #0284c7;
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 4px;
            margin-left: 8px;
            animation: pulseNowPlaying 2s infinite ease-in-out;
        }}
        .video-card.is-now-playing {{
            border-color: #38bdf8 !important;
            box-shadow: 0 0 16px rgba(56, 189, 248, 0.4) !important;
            background: rgba(56, 189, 248, 0.08) !important;
            position: relative;
        }}
        .file-row.is-now-playing {{
            border-color: #38bdf8 !important;
            background: rgba(56, 189, 248, 0.12) !important;
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.3) !important;
        }}
        .now-playing-badge {{
            position: absolute;
            top: 6px;
            left: 6px;
            background: rgba(2, 132, 199, 0.95);
