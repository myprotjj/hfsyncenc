            background: rgba(15, 23, 42, 0.96);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px 0;
            min-width: 175px;
            z-index: 100;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
        }}
        .yt-top-sub-menu {{
            bottom: auto !important;
            top: calc(100% + 6px) !important;
            right: 0 !important;
        }}
        .yt-top-cc-btn {{
            font-size: 0.85rem;
            color: #cbd5e1;
            padding: 4px 6px;
            border-radius: 4px;
            transition: all 0.2s ease;
        }}
        .yt-top-cc-btn:hover {{
            color: #fff;
            background: rgba(255, 255, 255, 0.12);
        }}
        .yt-top-cc-btn.active {{
            color: var(--primary) !important;
            background: rgba(56, 189, 248, 0.16) !important;
            border-bottom: 2px solid var(--primary) !important;
        }}
        .yt-sub-header {{
            padding: 4px 12px 6px;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            margin-bottom: 4px;
        }}
        .yt-sub-option {{
            padding: 6px 14px;
            font-size: 0.82rem;
            color: #e2e8f0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: background 0.15s ease;
        }}
        .yt-sub-option:hover {{
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
        }}
        .yt-sub-option.active {{
            color: var(--primary);
            font-weight: 600;
        }}
        .yt-sub-option.active::after {{
            content: "\2713";
            color: var(--primary);
            font-weight: bold;
            font-size: 0.85rem;
        }}
        .yt-audio-mode-btn.active {{
            color: #4ade80 !important;
            background: rgba(34, 197, 94, 0.2) !important;
            border: 1px solid rgba(34, 197, 94, 0.5) !important;
        }}
        .yt-audio-visualizer {{
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center, #1e293b 0%, #0b0f19 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 5;
            pointer-events: none;
        }}
        .yt-audio-icon {{
            font-size: 3rem;
            margin-bottom: 12px;
            animation: pulseIcon 2s infinite ease-in-out;
        }}
        .yt-audio-title {{
            font-size: 1.1rem;
            font-weight: 600;
            color: #f1f5f9;
            margin-bottom: 16px;
            max-width: 80%;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }}
        .yt-audio-bars {{
            display: flex;
            align-items: flex-end;
            gap: 5px;
            height: 48px;
            padding-bottom: 4px;
        }}
        .yt-audio-bars .bar {{
            width: 6px;
            background: linear-gradient(180deg, #4ade80 0%, #059669 100%);
            border-radius: 3px;
            height: 12px;
            animation: bounceBar 1.2s infinite ease-in-out;
        }}
        .yt-audio-bars .bar:nth-child(1) {{ animation-delay: 0.1s; height: 18px; }}
        .yt-audio-bars .bar:nth-child(2) {{ animation-delay: 0.3s; height: 32px; }}
        .yt-audio-bars .bar:nth-child(3) {{ animation-delay: 0.5s; height: 42px; }}
        .yt-audio-bars .bar:nth-child(4) {{ animation-delay: 0.2s; height: 26px; }}
        .yt-audio-bars .bar:nth-child(5) {{ animation-delay: 0.4s; height: 38px; }}
        .yt-audio-bars .bar:nth-child(6) {{ animation-delay: 0.6s; height: 20px; }}
        .yt-audio-bars .bar:nth-child(7) {{ animation-delay: 0.35s; height: 34px; }}
        .yt-audio-bars .bar:nth-child(8) {{ animation-delay: 0.15s; height: 14px; }}
        @keyframes bounceBar {{
            0%, 100% {{ transform: scaleY(0.4); opacity: 0.6; }}
            50% {{ transform: scaleY(1.1); opacity: 1; }}
        }}
        @keyframes pulseIcon {{
            0%, 100% {{ transform: scale(1); filter: drop-shadow(0 0 4px rgba(74, 222, 128, 0.4)); }}
            50% {{ transform: scale(1.1); filter: drop-shadow(0 0 16px rgba(74, 222, 128, 0.8)); }}
        }}
        .sub-track-item {{
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 6px;
            padding: 6px 10px;
            font-size: 0.82rem;
        }}
        .sub-track-lang {{
            font-weight: 600;
            color: #60a5fa;
            text-transform: uppercase;
            font-size: 0.75rem;
            background: rgba(59, 130, 246, 0.12);
            padding: 2px 6px;
            border-radius: 4px;
        }}
        ::cue {{
            background-color: rgba(0, 0, 0, 0.75);
            color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            font-size: 1.15rem;
            line-height: 1.4;
            text-shadow: 0 1px 2px rgba(0,0,0,0.8);
            border-radius: 4px;
            padding: 2px 8px;
        }}

        /* Android-style A-Z Fast Scroller */
        .az-scroller-rail {{
            position: fixed;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 1050;
            display: flex;
            flex-direction: column;
            align-items: center;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 6px 3px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
            user-select: none;
            touch-action: none;
            opacity: 0.35;
            transition: opacity 0.3s ease, transform 0.2s ease, background 0.2s ease;
        }}

        .az-scroller-rail:hover,
        .az-scroller-rail.active,
        .az-scroller-rail.scrolling {{
            opacity: 1;
            background: rgba(15, 23, 42, 0.94);
            border-color: rgba(56, 189, 248, 0.45);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.7);
        }}

        .az-letters-container {{
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1px;
        }}

        .az-letter-item {{
            font-size: 0.63rem;
            font-weight: 700;
