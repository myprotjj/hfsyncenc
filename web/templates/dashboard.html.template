        async function saveMetadata() {{
            if (!editingKey) return;
            const saveBtn = document.getElementById('saveMetadataBtn');
            const origText = saveBtn.textContent;
            saveBtn.textContent = "Saving to Jellyfin...";
            saveBtn.disabled = true;

            const title = document.getElementById('editTitle').value.trim();
            const year = document.getElementById('editYear').value.trim();
            const rating = document.getElementById('editRating').value.trim();
            const overview = document.getElementById('editOverview').value.trim();
            const genres = document.getElementById('editGenres').value.split(',').map(s => s.trim()).filter(Boolean);
            const tags = document.getElementById('editTags').value.split(',').map(s => s.trim()).filter(Boolean);
            const chkConflicts = document.getElementById('chkResolveConflicts');
            const resolveConflicts = chkConflicts ? chkConflicts.checked : true;

            const updatedMetadata = {{
                title: title,
                year: year,
                rating: rating,
                overview: overview,
                genres: genres,
                tags: tags
            }};

            try {{
                const res = await fetch('/api/metadata', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{
                        key: editingKey,
                        metadata: updatedMetadata,
                        resolve_conflicts: resolveConflicts
                    }})
                }});
                const result = await res.json();
                if (result && result.success) {{
                    const newKey = result.key || editingKey;
                    const oldKey = result.old_key || editingKey;

                    const f = allFiles.find(item => item.key === oldKey);
                    if (f) {{
                        f.key = newKey;
                        f.name = newKey.split('/').pop();
                        f.metadata = result.metadata;
                        f.aliases = result.aliases !== undefined ? result.aliases : [];
                        f.file_names = result.file_names !== undefined ? result.file_names : [newKey];
                    }}
                    if (typeof FILE_CACHE !== 'undefined' && FILE_CACHE) {{
                        if (oldKey !== newKey) delete FILE_CACHE[oldKey];
                        if (f) FILE_CACHE[newKey] = f;
                    }}
                    editingKey = newKey;
                    populateFilterDropdowns();
                    refreshTreeDisplay();
                    filterTree();
                    closeMetadataModal();
                    showToast("✅ Jellyfin metadata & .nfo saved instantly! Conflicts resolved.", "success");
                }} else {{
                    alert("Error updating metadata: " + ((result && result.message) || "Unknown error"));
                }}
            }} catch (err) {{
                alert("Failed to connect to server: " + err);
            }} finally {{
                saveBtn.textContent = origText;
                saveBtn.disabled = false;
            }}
        }}

