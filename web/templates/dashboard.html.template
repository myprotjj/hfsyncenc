            box-shadow: 0 0 10px rgba(245, 158, 11, 0.45), inset 0 0 6px rgba(245, 158, 11, 0.2) !important;
        }}
        .tool-btn-icon.is-active-amber::after,
        .tool-btn-icon.active-amber::after {{
            background: #f59e0b !important;
            box-shadow: 0 0 8px #f59e0b !important;
        }}

        /* Purple Active State (Merge Videos, etc.) */
        .tool-btn.is-active-purple,
        .tool-btn.active-purple,
        .tool-btn-icon.is-active-purple,
        .tool-btn-icon.active-purple {{
            background: rgba(168, 85, 247, 0.25) !important;
            border-color: #a855f7 !important;
            color: #c084fc !important;
            box-shadow: 0 0 12px rgba(168, 85, 247, 0.5), inset 0 0 6px rgba(168, 85, 247, 0.2) !important;
        }}
        .tool-btn-icon.is-active-purple::after,
        .tool-btn-icon.active-purple::after {{
            background: #a855f7 !important;
            box-shadow: 0 0 8px #a855f7 !important;
        }}

        /* Emerald/Green Active State (Expand All, etc.) */
        .tool-btn.is-active-green,
        .tool-btn.active-green,
        .tool-btn-icon.is-active-green,
        .tool-btn-icon.active-green {{
            background: rgba(16, 185, 129, 0.22) !important;
            border-color: #10b981 !important;
            color: #34d399 !important;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.45), inset 0 0 6px rgba(16, 185, 129, 0.2) !important;
        }}
        .tool-btn-icon.is-active-green::after,
        .tool-btn-icon.active-green::after {{
            background: #10b981 !important;
            box-shadow: 0 0 8px #10b981 !important;
        }}

        /* Blue Active State (Privacy Blur, etc.) */
        .tool-btn.is-active-blue,
        .tool-btn.active-blue,
        .tool-btn-icon.is-active-blue,
        .tool-btn-icon.active-blue {{
            background: rgba(59, 130, 246, 0.25) !important;
            border-color: #3b82f6 !important;
            color: #60a5fa !important;
            box-shadow: 0 0 12px rgba(59, 130, 246, 0.5), inset 0 0 6px rgba(59, 130, 246, 0.2) !important;
        }}
        .tool-btn-icon.is-active-blue::after,
        .tool-btn-icon.active-blue::after {{
            background: #3b82f6 !important;
            box-shadow: 0 0 8px #3b82f6 !important;
        }}

        /* Privacy Blur Mode Styles */
        body.privacy-blur-active .video-card-thumb,
        body.privacy-blur-active .thumb-canvas,
        body.privacy-blur-active .video-list-thumb,
        body.privacy-blur-active .screens-sheet-modal img,
        body.privacy-blur-active .thumb-screens-overlay {{
            filter: blur(14px) brightness(0.65) !important;
            transition: filter 0.2s ease;
        }}
        body.privacy-blur-active .video-card:hover .video-card-thumb,
        body.privacy-blur-active .video-card:hover .thumb-canvas,
        body.privacy-blur-active .video-card-thumb:hover,
        body.privacy-blur-active .video-list-row:hover .video-list-thumb {{
            filter: blur(0px) brightness(1) !important;
        }}

        body.privacy-blur-active .video-card-title,
        body.privacy-blur-active .video-card-sub,
        body.privacy-blur-active .card-overview-snippet,
        body.privacy-blur-active .video-list-title,
        body.privacy-blur-active .tree-file-label,
        body.privacy-blur-active .file-name,
        body.privacy-blur-active .alias-card-name,
        body.privacy-blur-active .resume-bar-title,
        body.privacy-blur-active #floatingResumeTitle,
        body.privacy-blur-active .floating-quick-resume-bar .resume-bar-title {{
            filter: blur(6px) !important;
            user-select: none !important;
            transition: filter 0.2s ease;
        }}
        body.privacy-blur-active .video-card:hover .video-card-title,
        body.privacy-blur-active .video-card:hover .video-card-sub,
        body.privacy-blur-active .video-card:hover .card-overview-snippet,
        body.privacy-blur-active .video-card-title:hover,
        body.privacy-blur-active .video-list-row:hover .video-list-title,
        body.privacy-blur-active .video-list-row:hover .file-name,
        body.privacy-blur-active .file-name:hover,
        body.privacy-blur-active .video-card:hover .alias-card-name,
        body.privacy-blur-active .floating-quick-resume-bar:hover .resume-bar-title,
        body.privacy-blur-active #floatingResumeTitle:hover {{
            filter: blur(0px) !important;
            user-select: auto !important;
        }}

        @keyframes pulse-dot {{
            0%, 100% {{ transform: scale(1); opacity: 1; }}
            50% {{ transform: scale(1.35); opacity: 0.75; }}
        }}

        /* View Toggle Group Active State */
        .view-toggle-btn.active,
        .view-toggle-btn.is-active {{
            background: linear-gradient(135deg, #0284c7, #0369a1) !important;
            border-color: #38bdf8 !important;
            color: #ffffff !important;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.35) !important;
            transform: scale(1.06);
            position: relative;
        }}
        .view-toggle-btn.active::after,
        .view-toggle-btn.is-active::after {{
            content: '';
            position: absolute;
            bottom: -1px;
            left: 20%;
            right: 20%;
            height: 2px;
            background: #38bdf8;
            border-radius: 2px;
            box-shadow: 0 0 6px #38bdf8;
        }}

        /* Mark for Merge Buttons on Cards and Rows */
        .btn-mark-merge {{
            color: #c084fc !important;
            border-color: rgba(168, 85, 247, 0.4) !important;
            background: rgba(168, 85, 247, 0.1) !important;
            font-size: 0.75rem !important;
            padding: 4px 10px !important;
            border-radius: 6px !important;
            cursor: pointer;
            transition: all 0.18s ease !important;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }}
        .btn-mark-merge:hover {{
            background: rgba(168, 85, 247, 0.22) !important;
            border-color: #c084fc !important;
            color: #fff !important;
            transform: translateY(-1px);
        }}
        .btn-mark-merge.active,
        .btn-mark-merge.is-active,
        .card-mark-merge-pill.active,
        .card-mark-merge-pill.is-active,
        .btn-card-merge.active,
        .btn-card-merge.is-active {{
            background: #9333ea !important;
            border-color: #d8b4fe !important;
            color: #ffffff !important;
            font-weight: 700 !important;
            box-shadow: 0 0 12px rgba(168, 85, 247, 0.7) !important;
            transform: scale(1.04) !important;
        }}

        .folder-action-icon-btn:hover {{
            transform: scale(1.08);
        }}
        .folder-action-icon-btn.btn-sync-icon:hover {{
            background: rgba(56, 189, 248, 0.12) !important;
            border-color: rgba(56, 189, 248, 0.25) !important;
