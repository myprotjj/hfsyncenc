        /* Merged Duplicate Hashes & Video Deduplication Engine */
        function PathLeaf(p) {{
            if (!p) return '';
            let s = String(p);
            if (s.indexOf('/') !== -1) s = s.substring(s.lastIndexOf('/') + 1);
            if (s.indexOf(String.fromCharCode(92)) !== -1) s = s.substring(s.lastIndexOf(String.fromCharCode(92)) + 1);
            return s;
        }}

        function renderEditLinkedHashes(key, hashes) {{
            const box = document.getElementById('editLinkedHashesBox');
            const list = document.getElementById('editLinkedHashesList');
            const badge = document.getElementById('linkedHashesBadge');
            if (!box || !list) return;

            const count = (hashes || []).length;
            if (badge) badge.textContent = count;

            if (!hashes || count === 0) {{
                list.innerHTML = `
                    <div style="font-size: 0.75rem; color: #64748b; font-style: italic; padding: 4px 0;">
                        No merged duplicate hashes linked yet. 
                        <a href="javascript:void(0)" onclick="openMergeVideosModal('${{escapeHtml(key)}}')" style="color: #38bdf8; text-decoration: underline; font-style: normal; margin-left: 4px;">
                            Merge a duplicate video
                        </a> to link its fingerprint.
                    </div>`;
                return;
            }}

            list.innerHTML = hashes.map(h => {{
                const hVal = (typeof h === 'object' && h !== null) ? (h.hash || '') : String(h);
                const sName = (typeof h === 'object' && h !== null) ? (h.source_name || h.source_key || 'Duplicate Video') : 'Duplicate Video';
                const sRes = (typeof h === 'object' && h !== null && h.resolution) ? h.resolution : '';
                const sSize = (typeof h === 'object' && h !== null && h.orig_size) ? formatBytes(h.orig_size) : '';
                const sDate = (typeof h === 'object' && h !== null && h.merged_at) ? h.merged_at : '';
                const metaDetails = [sRes, sSize, sDate ? `Merged ${{sDate}}` : ''].filter(Boolean).join(' &bull; ');

                return `
                <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.3); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 6px; padding: 6px 10px;">
                    <div style="min-width: 0; flex: 1; margin-right: 8px;">
                        <div style="font-size: 0.8rem; font-weight: 600; color: #f1f5f9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            ${{escapeHtml(sName)}}
                        </div>
                        <div style="font-size: 0.70rem; color: #94a3b8; display: flex; align-items: center; gap: 6px; margin-top: 1px;">
                            ${{metaDetails ? `<span>${{escapeHtml(metaDetails)}}</span> &bull; ` : ''}}
                            <code style="color: #38bdf8; font-size: 0.68rem;">${{escapeHtml(hVal.substring(0, 16))}}...</code>
                        </div>
                    </div>
                    <button type="button" class="btn btn-danger btn-xs" onclick="unlinkVideoHash('${{escapeHtml(key)}}', '${{escapeHtml(hVal)}}')" style="padding: 2px 7px; font-size: 0.70rem; white-space: nowrap;" title="Unlink this hash. This duplicate file will then be allowed to sync again.">
                        &#128465; Unlink
                    </button>
                </div>`;
            }}).join('');
        }}

        async function unlinkVideoHash(key, hash) {{
            if (!confirm(`Are you sure you want to unlink this fingerprint (${{hash.substring(0, 12)}}...)?\n\nIf you unlinked by mistake, that video file will be eligible to sync again.`)) {{
                return;
            }}

            try {{
                showToast('Unlinking fingerprint...', 'info');
                const resp = await fetch('/api/videos/unlink-hash', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ key, hash }})
                }});
                const res = await resp.json();
                if (res.success) {{
                    showToast(res.message || 'Hash unlinked successfully!', 'success');
                    const file = allFiles.find(f => f.key === key);
                    if (file) {{
                        file.extra_media_hashes = res.extra_media_hashes || [];
                        renderEditLinkedHashes(key, file.extra_media_hashes);
                    }}
                }} else {{
                    alert('Failed to unlink hash: ' + (res.error || 'Unknown error'));
                }}
            }} catch (e) {{
                alert('Unlink hash error: ' + e);
            }}
        }}

                        let markedForMergeKeys = new Set();
        let mergeKeptKey = null;
        let mergeTargetTitle = '';

        function cleanTitleForDedup(title) {{
            if (!title) return '';
            let t = String(title).toLowerCase();
            t = t.replace(/\.[a-z0-9]{{2,4}}$/i, '');
            t = t.replace(/\s*\(\d+\)|\s*\bcopy\b|\s*\[.*?\]|\s*\b(1080p|720p|480p|360p|4k|hd|sd|x264|h264|x265|hevc)\b/gi, '');
            t = t.replace(/[^a-z0-9]+/g, ' ').trim();
            if (!t) return '';
            return t.split(/\s+/).map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
        }}

        function getFileThumbHtml(f, w = 76, h = 46) {{
            if (!f) return `<div style="width:${{w}}px;height:${{h}}px;background:#0f172a;display:flex;align-items:center;justify-content:center;color:#64748b;font-size:1.1rem;border-radius:4px;">&#127916;</div>`;
            const safeId = f.safe_id || (f.key ? f.key.replace(/[^a-zA-Z0-9_-]/g, '_') : '');
            const vTag = f.sb_version || (f.uploaded_at ? encodeURIComponent(f.uploaded_at) : '1');
            const thumbUrl = (f.screens_thumb_url) ? f.screens_thumb_url : (f.has_screens ? `/api/screens/thumb?id=${{safeId}}&v=${{vTag}}` : '');
            if (thumbUrl) {{
                return `<img src="${{thumbUrl}}" style="width:${{w}}px;height:${{h}}px;object-fit:cover;border-radius:4px;" onerror="this.outerHTML='<div style=\'width:${{w}}px;height:${{h}}px;background:#0f172a;display:flex;align-items:center;justify-content:center;color:#64748b;font-size:1.1rem;\'>&#127916;</div>'">`;
            }}
            return `<div style="width:${{w}}px;height:${{h}}px;background:#0f172a;display:flex;align-items:center;justify-content:center;color:#64748b;font-size:1.1rem;border-radius:4px;">&#127916;</div>`;
        }}

        function getFileResolutionScore(f) {{
            if (!f) return -1;
            const mi = f.media_info || {{}};
            const meta = f.metadata || {{}};
            const res = String(mi.resolution_label || meta.resolution || '').toLowerCase();
            const resOrder = {{ '4k': 5, '1440p': 4, '1080p': 3, '720p': 2, '480p': 1, '360p': 1, 'sd': 0 }};
            for (const [k, v] of Object.entries(resOrder)) {{
                if (res.includes(k)) return v;
            }}
            return 0;
        }}

        function pickBestVideoKey(filesList) {{
            if (!filesList || filesList.length === 0) return null;
            let best = filesList[0];
            for (let i = 1; i < filesList.length; i++) {{
                const f = filesList[i];
                const scoreF = getFileResolutionScore(f);
                const scoreBest = getFileResolutionScore(best);
                if (scoreF > scoreBest) {{
                    best = f;
                }} else if (scoreF === scoreBest) {{
                    if ((f.orig_size || 0) > (best.orig_size || 0)) {{
                        best = f;
                    }}
                }}
            }}
            return best.key;
        }}

        function findDetectedDuplicatePairs() {{
            const pairs = [];
            const seen = new Set();
            for (let i = 0; i < allFiles.length; i++) {{
                const f1 = allFiles[i];
                const t1 = (f1.metadata && f1.metadata.title) ? f1.metadata.title : PathLeaf(f1.key);
                const c1 = cleanTitleForDedup(t1).toLowerCase();
                if (!c1 || c1.length < 3) continue;

                for (let j = i + 1; j < allFiles.length; j++) {{
                    const f2 = allFiles[j];
                    const t2 = (f2.metadata && f2.metadata.title) ? f2.metadata.title : PathLeaf(f2.key);
                    const c2 = cleanTitleForDedup(t2).toLowerCase();
                    if (!c2 || c2.length < 3) continue;

                    const pairKey = f1.key < f2.key ? `${{f1.key}}:::${{f2.key}}` : `${{f2.key}}:::${{f1.key}}`;
                    if (seen.has(pairKey)) continue;

                    if (c1 === c2) {{
                        seen.add(pairKey);
                        pairs.push({{ file1: f1, file2: f2, title1: t1, title2: t2 }});
                    }}
                }}
            }}
            return pairs;
        }}

