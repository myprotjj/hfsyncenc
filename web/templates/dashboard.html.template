        .folder-header:hover .folder-action-icon-btn {{
            color: #94a3b8;
        }}
        .tool-btn-icon {{
            width: 32px !important;
            height: 32px !important;
            min-width: 32px !important;
            padding: 0 !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            font-size: 0.95rem !important;
            border-radius: 7px !important;
            position: relative;
            flex-shrink: 0;
            transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
        }}
        .tool-btn-icon:hover {{
            transform: scale(1.08);
            border-color: rgba(56, 189, 248, 0.4);
        }}
        .view-toggle-icon {{
            padding: 5px 8px !important;
            font-size: 0.92rem !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }}
        /* Global Active States for Tool Buttons & Icon Buttons */
        .tool-btn.is-active,
        .tool-btn.active,
        .tool-btn-icon.is-active,
        .tool-btn-icon.active {{
            background: rgba(56, 189, 248, 0.22) !important;
            border-color: #38bdf8 !important;
            color: #38bdf8 !important;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.45), inset 0 0 6px rgba(56, 189, 248, 0.2) !important;
        }}

        .folder-action-icon-btn.btn-power-rename-icon:hover {{
            color: #38bdf8 !important;
            background: rgba(56, 189, 248, 0.15) !important;
            border-color: rgba(56, 189, 248, 0.4) !important;
        }}
        .pr-preview-row {{
            display: grid;
            grid-template-columns: 36px 36px 1fr 24px 1fr;
            align-items: center;
            padding: 7px 14px;
            font-size: 0.82rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            transition: background 0.15s ease;
        }}
        .pr-preview-row:hover {{
            background: rgba(255, 255, 255, 0.03);
        }}
        .pr-preview-row.is-excluded {{
            opacity: 0.35;
        }}
        .pr-old-name {{
            color: #94a3b8;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }}
        .pr-new-name {{
            color: #38bdf8;
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }}

        /* Glowing accent dot indicator on top-right of active icon buttons */
        .tool-btn-icon.is-active::after,
        .tool-btn-icon.active::after {{
            content: '';
            position: absolute;
            top: 2px;
            right: 2px;
            width: 7px;
            height: 7px;
            background: #38bdf8;
            border-radius: 50%;
            box-shadow: 0 0 8px #38bdf8;
            border: 1px solid rgba(15, 23, 42, 0.8);
            animation: pulse-dot 1.8s infinite ease-in-out;
            pointer-events: none;
        }}

        /* Amber Active State (e.g. Tags Hidden) */
        .tool-btn.is-active-amber,
        .tool-btn.active-amber,
        .tool-btn-icon.is-active-amber,
        .tool-btn-icon.active-amber {{
            background: rgba(245, 158, 11, 0.22) !important;
