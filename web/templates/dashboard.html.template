            border-color: rgba(255, 255, 255, 0.2) !important;
            color: #f1f5f9 !important;
        }}
        .folder-action-icon-btn.btn-delete-icon:hover {{
            background: rgba(239, 68, 68, 0.12) !important;
            border-color: rgba(239, 68, 68, 0.25) !important;
            color: #ef4444 !important;
        }}
        .staging-floating-trigger {{
            position: fixed;
            left: 20px;
            bottom: 30px;
            z-index: 9999;
            cursor: pointer;
            user-select: none;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }}
        .staging-floating-trigger:hover {{
            transform: translateY(-3px) scale(1.03);
        }}
        .staging-floating-inner {{
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 16px;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(30, 41, 59, 0.94));
            border: 1px solid rgba(56, 189, 248, 0.45);
            border-radius: 9999px;
            box-shadow: 0 12px 30px -4px rgba(0, 0, 0, 0.7), 0 0 18px rgba(56, 189, 248, 0.25);
            backdrop-filter: blur(12px);
        }}
        .staging-floating-icon {{
            font-size: 1.15rem;
            color: #38bdf8;
            animation: stagingPulse 2s infinite ease-in-out;
        }}
        .staging-floating-title {{
            font-size: 0.82rem;
            font-weight: 700;
            color: #f8fafc;
            letter-spacing: 0.3px;
            display: block;
        }}
        .staging-floating-badge {{
            font-size: 0.68rem;
            font-weight: 700;
            color: #38bdf8;
            background: rgba(56, 189, 248, 0.15);
            padding: 1px 7px;
            border-radius: 9999px;
            border: 1px solid rgba(56, 189, 248, 0.3);
            display: inline-block;
            margin-top: 1px;
