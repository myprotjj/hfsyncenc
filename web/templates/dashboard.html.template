        .thumb-scrub-bar {{
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 7px;
            background: rgba(255, 255, 255, 0.25);
            opacity: 0;
            transition: opacity 0.15s, height 0.15s;
            pointer-events: auto;
            cursor: pointer;
            z-index: 10;
