        function updateCardResumeIndicators(safeId, time, duration) {{
            const cards = document.querySelectorAll(`[data-safeid="${{safeId}}"]`);
            cards.forEach(card => {{
                let resumeBar = card.querySelector('.card-resume-bar');
                let resumePill = card.querySelector('.card-resume-badge');
                if (time > 3 && duration > 0) {{
                    const pct = Math.min(100, Math.round((time / duration) * 100));
                    if (!resumeBar) {{
                        resumeBar = document.createElement('div');
                        resumeBar.className = 'card-resume-bar';
                        card.appendChild(resumeBar);
                    }}
                    resumeBar.style.width = pct + '%';
                    resumeBar.style.display = 'block';

                    if (!resumePill) {{
                        resumePill = document.createElement('div');
                        resumePill.className = 'card-resume-badge';
                        card.appendChild(resumePill);
                    }}
                    resumePill.textContent = '⏱️ ' + formatTime(time);
                    resumePill.title = `Resume at ${{formatTime(time)}} / ${{formatTime(duration)}} (${{pct}}%)`;
                    resumePill.style.display = 'block';
                }} else {{
                    if (resumeBar) resumeBar.style.display = 'none';
                    if (resumePill) resumePill.style.display = 'none';
                }}
            }});
        }}

        function saveLastClosedVideoSnapshot() {{
            const player = document.getElementById('videoPlayer');
            const playerTitle = document.getElementById('playerTitle');
            if (!player) return;

            const cur = player.currentTime || 0;
            const dur = player.duration || 0;
            let key = currentVideoKey || '';
            if (key.startsWith('play/')) key = key.substring(5);
            if (key.startsWith('/stream/play/')) key = key.substring(13);
            if (key.startsWith('/stream/')) key = key.substring(8);

            const fileObj = (allFiles || []).find(f => 
                f.key === key || 
                f.safe_id === key || 
                (f.file_names && f.file_names.includes(key))
            );
            const resolvedKey = fileObj ? fileObj.key : key;
            let safeId = fileObj ? fileObj.safe_id : (currentPlayingSafeId || resolvedKey);
            if (safeId.startsWith('play/')) safeId = safeId.substring(5);
            if (!safeId) return;

            // If user finished video (< 5s left), wrap to 0:
            const resumeTime = (dur > 0 && cur >= dur - 5) ? 0 : Math.floor(cur);

            const snapshot = {{
                key: resolvedKey || safeId,
                safeId: safeId,
                title: (playerTitle ? playerTitle.textContent : '') || resolvedKey || 'Video',
                blobPath: currentBlobId || '',
                time: resumeTime,
                duration: Math.floor(dur),
                updated: Date.now()
            }};

            try {{
                localStorage.setItem('hfsync_last_closed_video', JSON.stringify(snapshot));
            }} catch (e) {{}}
        }}

        function getLastClosedVideo() {{
            try {{
                const raw = localStorage.getItem('hfsync_last_closed_video');
                if (raw) {{
                    const data = JSON.parse(raw);
                    if (data && (data.safeId || data.key)) {{
                        // Automatically heal any snapshot containing 'play/' prefix
                        if (data.safeId && data.safeId.startsWith('play/')) {{
                            data.safeId = data.safeId.substring(5);
                        }}
                        if (data.key && data.key.startsWith('play/')) {{
                            data.key = data.key.substring(5);
                        }}
                        return data;
                    }}
                }}
            }} catch (e) {{}}
            return null;
        }}

        function updateQuickResumeUI() {{
            const box = document.getElementById('playerBox');
            const isPlayerOpen = box && box.style.display !== 'none';
            const floatingBar = document.getElementById('floatingResumeBar');

            // If player is currently open, hide floating resume popup
            if (isPlayerOpen) {{
                if (floatingBar) floatingBar.style.display = 'none';
                return;
            }}

            const last = getLastClosedVideo();
            if (!last || (!last.safeId && !last.key)) {{
                if (floatingBar) floatingBar.style.display = 'none';
                return;
            }}

            // Populate Floating Bottom-Right Popup Bar
            if (floatingBar) {{
                const titleEl = document.getElementById('floatingResumeTitle');
                const badgeEl = document.getElementById('floatingResumeBadge');
                const progEl = document.getElementById('floatingResumeProgress');
                if (titleEl) titleEl.textContent = last.title || last.key || 'Resume Video';

                const curFormatted = formatTime(last.time || 0);
                const durFormatted = (last.duration && last.duration > 0) ? formatTime(last.duration) : '--:--';
                if (badgeEl) badgeEl.textContent = `⏱️ ${{curFormatted}} / ${{durFormatted}} (Press R)`;

                if (progEl) {{
                    const pct = (last.duration && last.duration > 0) ? Math.min(100, Math.max(0, (last.time / last.duration) * 100)) : 0;
                    progEl.style.width = pct.toFixed(1) + '%';
                }}
                floatingBar.style.display = 'flex';
            }}
        }}

        function resumeLastClosedVideo(event) {{
            if (event) {{
                event.stopPropagation();
            }}
            const last = getLastClosedVideo();
            if (!last || (!last.key && !last.safeId)) return;

            // Find matching file in allFiles to ensure exact key and blobPath
            const fileObj = (allFiles || []).find(f => 
                (last.safeId && f.safe_id === last.safeId) || 
                (last.key && f.key === last.key) || 
                (f.file_names && f.file_names.includes(last.key))
            );

            const playKey = fileObj ? fileObj.key : (last.key || last.safeId);
            const playTitle = fileObj ? (fileObj.title || fileObj.display_name || playKey) : (last.title || playKey);
            const playBlob = fileObj ? (fileObj.blob_path || '') : (last.blobPath || '');
            const playTime = (typeof last.time === 'number') ? last.time : 0;

            // Respect mini player: DO NOT scroll to top; playVideo automatically docks to mini player if scrolled down!
            playVideo('/stream/' + playKey, playTitle, playBlob, playTime);
            updateQuickResumeUI();
        }}

        function dismissQuickResume(event) {{
            if (event) {{
                event.stopPropagation();
            }}
            try {{
                localStorage.removeItem('hfsync_last_closed_video');
            }} catch (e) {{}}
            updateQuickResumeUI();
        }}

        async function toggleMakeOffline(safeId, event) {{
            if (event) event.stopPropagation();
            const fileObj = (allFiles || []).find(f => f.safe_id === safeId);
            if (!fileObj) return;

            const nextPinned = !fileObj.pinned_offline;
            fileObj.pinned_offline = nextPinned;
            fileObj.is_downloading = nextPinned && ((fileObj.cache_pct || 0) < 99.5);
            updateCardOfflineUI(safeId, nextPinned, fileObj.cache_pct || 0, fileObj.cached_size_str || '0 B', fileObj.is_downloading);

            try {{
                const res = await fetch('/api/cache/offline', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ safe_id: safeId, enabled: nextPinned }})
                }});
                const data = await res.json();
                if (data.success) {{
                    showToast(nextPinned ? '📌 Video queued for offline caching! Downloading in background...' : '⏱️ Offline pin removed. Cache will auto-expire 24h after last play.');
                    if (nextPinned) {{
                        startCacheStatsPolling();
                    }} else {{
                        pollCacheStats();
                    }}
                }} else {{
                    showToast('⚠️ ' + (data.message || 'Operation failed'));
                    fileObj.pinned_offline = !nextPinned;
                    fileObj.is_downloading = false;
                    updateCardOfflineUI(safeId, !nextPinned, fileObj.cache_pct || 0, fileObj.cached_size_str || '0 B', false);
                }}
            }} catch (err) {{
                showToast('⚠️ Request error: ' + err);
                fileObj.pinned_offline = !nextPinned;
                fileObj.is_downloading = false;
                updateCardOfflineUI(safeId, !nextPinned, fileObj.cache_pct || 0, fileObj.cached_size_str || '0 B', false);
            }}
        }}

        let cacheStatsPollTimer = null;
        let isPollingCacheStats = false;

        async function pollCacheStats() {{
            if (isPollingCacheStats) return false;
            isPollingCacheStats = true;
            let hasActiveWork = false;
            try {{
                const res = await fetch('/api/cache/stats');
                if (!res.ok) return false;
                const stats = await res.json();

                // Update total cache size display in header
                const statCacheEl = document.getElementById('statCache');
                if (statCacheEl && stats.total_cached_size_str) {{
                    statCacheEl.textContent = stats.total_cached_size_str;
                }}

                const fileStats = stats.files || {{}};
                for (const [sId, fStat] of Object.entries(fileStats)) {{
                    if (fStat.is_downloading) {{
                        hasActiveWork = true;
                    }}
                    const fileObj = (allFiles || []).find(f => f.safe_id === sId);
                    if (fileObj) {{
                        const wasDownloading = !!fileObj.is_downloading;
                        fileObj.cache_pct = fStat.percentage;
                        fileObj.cached_bytes = fStat.cached_bytes;
                        fileObj.cached_size_str = fStat.cached_size_str;
                        fileObj.pinned_offline = fStat.pinned_offline;
                        fileObj.is_downloading = fStat.is_downloading;

                        if (wasDownloading && !fStat.is_downloading && fStat.percentage >= 99.5) {{
                            showToast(`✅ Offline Ready: "${{fileObj.title || fileObj.key}}" is 100% saved locally!`);
                        }}
                    }}
                    updateCardOfflineUI(sId, fStat.pinned_offline, fStat.percentage, fStat.cached_size_str, fStat.is_downloading);
                }}

                // Check if currently playing video is active and needs polling
                const player = document.getElementById('videoPlayer');
                const isPlaying = player && !player.paused && !player.ended && player.readyState > 1;
                if (isPlaying && currentPlayingSafeId) {{
                    hasActiveWork = true;
                }}
            }} catch (err) {{
            }} finally {{
                isPollingCacheStats = false;
            }}
            return hasActiveWork;
        }}

        function startCacheStatsPolling() {{
            pollCacheStats();
            if (cacheStatsPollTimer) return;
            cacheStatsPollTimer = setInterval(async () => {{
                const active = await pollCacheStats();
                const player = document.getElementById('videoPlayer');
                const isPlaying = player && !player.paused && !player.ended && player.readyState > 1;
                if (!active && !isPlaying) {{
                    clearInterval(cacheStatsPollTimer);
                    cacheStatsPollTimer = null;
                }}
            }}, 1500);
        }}

        function pollOfflineDownloadProgress(safeId) {{
            startCacheStatsPolling();
        }}

        function updateCardOfflineUI(safeId, isPinned, pct, sizeStr, isDownloading) {{
            const numPct = typeof pct === 'number' ? Math.round(pct) : (parseFloat(pct) || 0);
            const isFullyOffline = isPinned && numPct >= 99.5;
            const isProcessing = (isPinned && numPct < 99.5) || !!isDownloading;

            const pill = document.getElementById(`cachePill_${{safeId}}`);
            if (pill) {{
                if (isFullyOffline) {{
                    pill.className = 'card-cache-pill is-pinned';
                    pill.innerHTML = `<span class="cache-pill-icon">📌</span> <span class="cache-pill-text">Offline Ready</span> <span class="cache-pill-size">(${{sizeStr}})</span>`;
                    pill.title = `📌 Offline Ready: 100% saved locally forever (${{sizeStr}})`;
                }} else if (isProcessing) {{
                    pill.className = 'card-cache-pill is-downloading';
                    pill.innerHTML = `<span class="cache-pulse-icon">⏳</span> <span class="cache-pill-text">Downloading ${{numPct}}%</span> <span class="cache-pill-size">(${{sizeStr}})</span>`;
                    pill.title = `⏳ Downloading Offline: ${{numPct}}% (${{sizeStr}}) • Saving full video locally`;
                }} else if (numPct > 0 && isPinned) {{
                    pill.className = 'card-cache-pill is-cached';
                    pill.innerHTML = `<span class="cache-pill-icon">💾</span> <span class="cache-pill-text">${{numPct}}%</span> <span class="cache-pill-size">(${{sizeStr}})</span>`;
                    pill.title = `💾 Local Encrypted Cache: ${{numPct}}% (${{sizeStr}})`;
                }} else {{
                    pill.className = 'card-cache-pill is-cloud';
                    pill.innerHTML = `<span class="cache-pill-icon">☁️</span> <span class="cache-pill-text">Cloud Stream</span>`;
                    pill.title = '☁️ Cloud Stream: Decrypted in real-time on demand (Zero disk space used)';
                }}
            }}

            const fill = document.getElementById(`cacheFill_${{safeId}}`);
            if (fill) {{
                fill.className = `thumb-cache-fill ${{isFullyOffline ? 'is-pinned-fill' : (isProcessing ? 'is-downloading-fill' : '')}}`;
                fill.style.width = isPinned ? (Math.min(100, Math.max(0, numPct)) + '%') : '0%';
            }}

            const btn = document.getElementById(`btnOffline_${{safeId}}`);
            if (btn) {{
                if (isFullyOffline) {{
                    btn.className = 'card-icon-btn btn-card-offline is-pinned-active';
                    btn.innerHTML = '📌';
                    btn.title = '📌 Offline Ready (Pinned Forever). Click to remove offline cache.';
                }} else if (isProcessing) {{
                    btn.className = 'card-icon-btn btn-card-offline is-downloading-active';
                    btn.innerHTML = '⏳';
                    btn.title = `⏳ Downloading Offline: ${{numPct}}% (${{sizeStr}}). Click to cancel.`;
                }} else {{
                    btn.className = 'card-icon-btn btn-card-offline';
                    btn.innerHTML = '📥';
                    btn.title = '📥 Make Offline Available: Download & save full video offline forever';
                }}
            }}

            const tagBtn = document.getElementById(`tagOffline_${{safeId}}`);
            if (tagBtn) {{
                if (isFullyOffline) {{
                    tagBtn.className = 'card-offline-tag-btn active';
                    tagBtn.innerHTML = '📌';
                    tagBtn.title = `📌 Offline Ready: 100% saved locally forever (${{sizeStr}}). Click to remove.`;
                }} else if (isProcessing) {{
                    tagBtn.className = 'card-offline-tag-btn downloading';
                    tagBtn.innerHTML = '<span class="cache-pulse-icon">⏳</span>';
                    tagBtn.title = `⏳ Downloading offline: ${{numPct}}% (${{sizeStr}}). Click to cancel.`;
                }} else {{
                    tagBtn.className = 'card-offline-tag-btn';
                    tagBtn.innerHTML = '📥';
                    tagBtn.title = '📥 Make offline available (Download & save full video offline forever)';
                }}
            }}
        }}

        function setMiniPlayerSize(size, event) {{
            if (event) event.stopPropagation();
            const container = document.getElementById('ytContainer');
            if (!container) return;
            const valid = ['s', 'm', 'l'];
            const s = valid.includes(size) ? size : 'm';
            container.classList.remove('mini-size-s', 'mini-size-m', 'mini-size-l');
            container.classList.add('mini-size-' + s);
            try {{
                localStorage.setItem('hfsync_mini_size', s);
            }} catch (e) {{}}
            document.querySelectorAll('.yt-mini-size-btn').forEach(b => {{
                b.classList.toggle('active', b.dataset.size === s);
            }});
        }}

        function initMiniPlayerDraggable() {{
            const container = document.getElementById('ytContainer');
            const header = container ? container.querySelector('.yt-top-overlay') : null;
            if (!container || !header || container.dataset.draggableInited) return;
            container.dataset.draggableInited = "1";

            let isDragging = false;
            let startX = 0, startY = 0;
            let initialLeft = 0, initialTop = 0;

            header.addEventListener('pointerdown', (e) => {{
                if (!container.classList.contains('is-floating-mini')) return;
                if (e.target.closest('button') || e.target.closest('a') || e.target.closest('.yt-mini-size-controls')) return;

                isDragging = true;
                header.setPointerCapture(e.pointerId);
                const rect = container.getBoundingClientRect();
                initialLeft = rect.left;
                initialTop = rect.top;
                startX = e.clientX;
                startY = e.clientY;

                container.style.bottom = 'auto';
                container.style.right = 'auto';
                container.style.left = `${{initialLeft}}px`;
                container.style.top = `${{initialTop}}px`;
                container.style.userSelect = 'none';
            }});

            header.addEventListener('pointermove', (e) => {{
                if (!isDragging) return;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                const newLeft = Math.max(6, Math.min(window.innerWidth - container.offsetWidth - 6, initialLeft + dx));
                const newTop = Math.max(6, Math.min(window.innerHeight - container.offsetHeight - 6, initialTop + dy));
                container.style.left = `${{newLeft}}px`;
                container.style.top = `${{newTop}}px`;
            }});

            const endDrag = (e) => {{
                if (isDragging) {{
                    isDragging = false;
                    container.style.userSelect = '';
                    try {{ header.releasePointerCapture(e.pointerId); }} catch (err) {{}}
                }}
            }};
            header.addEventListener('pointerup', endDrag);
            header.addEventListener('pointercancel', endDrag);
        }}

        function handleCardThumbClick(card, event) {{
            if (!card) return;
            if (event && (event.target.closest('button') || event.target.closest('a'))) return;
            const key = card.dataset.key;
            const safeId = card.dataset.safeid;
            const fileObj = (allFiles || []).find(f => f.key === key || f.safe_id === safeId);
            const title = fileObj ? (fileObj.metadata?.title || key) : key;
            const blobPath = fileObj ? (fileObj.blob_path || '') : '';
            const dur = fileObj ? (fileObj.duration_sec || 0) : 0;

            const rect = card.getBoundingClientRect();
            // Strictly detect if user specifically clicked in the blue line area / scrub seekbar
            const clickedOnScrubBar = Boolean(event && event.target && event.target.closest && event.target.closest('.thumb-scrub-bar'))
                || (card.dataset.overScrub === '1')
                || (event && typeof event.clientY === 'number' && (event.clientY >= rect.bottom - 18));

            let seekTime = 0;
            const savedPos = getSavedVideoPosition(safeId);

            if (clickedOnScrubBar && event && typeof event.clientX === 'number') {{
                // ONLY play from scrub location when clicking on the blue scrub seekbar
                const pct = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
                seekTime = Math.max(0, Math.floor(pct * dur));
            }} else if (savedPos && savedPos.time > 5) {{
                // Otherwise play from where left earlier (resume position)
                seekTime = savedPos.time;
            }} else {{
                // Or start from the beginning (0:00)
                seekTime = 0;
            }}
            playVideo('/stream/' + key, title, blobPath, seekTime);
        }}

        function activateFloatingMiniPlayer() {{
            const box = document.getElementById('playerBox');
            const container = document.getElementById('ytContainer');
            if (!box || !container || isFloatingMini) return;

            // Preserve placeholder space so document does not jump
            if (box.offsetHeight > 100) {{
                box.style.minHeight = box.offsetHeight + 'px';
            }} else {{
                box.style.minHeight = '380px';
            }}
            container.classList.add('is-floating-mini');
            isFloatingMini = true;

            // Always reset position to bottom right on every activation/open
            container.style.left = '';
            container.style.top = '';
            container.style.bottom = '24px';
            container.style.right = '24px';

            let savedSize = 'm';
            try {{ savedSize = localStorage.getItem('hfsync_mini_size') || 'm'; }} catch (e) {{}}
            setMiniPlayerSize(savedSize);
            initMiniPlayerDraggable();
        }}

        function deactivateFloatingMiniPlayer() {{
            const box = document.getElementById('playerBox');
            const container = document.getElementById('ytContainer');
            if (!box || !container || !isFloatingMini) return;

            container.classList.remove('is-floating-mini');
            container.style.left = '';
            container.style.top = '';
            container.style.bottom = '';
            container.style.right = '';
            box.style.minHeight = '';
            isFloatingMini = false;
        }}

        function expandFromFloatingMini() {{
            const box = document.getElementById('playerBox');
            if (box) {{
                deactivateFloatingMiniPlayer();
                box.scrollIntoView({{ behavior: 'smooth', block: 'start' }});
