        }}

        function unmarkSingleVideoInModal(key, event) {{
            if (event) event.stopPropagation();
            markedForMergeKeys.delete(key);
            if (mergeKeptKey === key) mergeKeptKey = null;
            updateMarkedMergeUI();
            renderMarkedMergeModal();
        }}

