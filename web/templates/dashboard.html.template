        }}

        function formatTime(sec) {{
            if (isNaN(sec) || sec < 0) return "00:00";
            const h = Math.floor(sec / 3600);
            const m = Math.floor((sec % 3600) / 60);
            const s = Math.floor(sec % 60);
            const pad = (n) => String(n).padStart(2, "0");
            if (h > 0) {{
                return `${{h}}:${{pad(m)}}:${{pad(s)}}`;
            }}
            return `${{pad(m)}}:${{pad(s)}}`;
        }}

        function flashCenterFeedback(text) {{
            const fb = document.getElementById('ytCenterFeedback');
            if (!fb) return;
            fb.textContent = text;
            fb.classList.remove('show');
            void fb.offsetWidth; // Force reflow
            fb.classList.add('show');
            setTimeout(() => fb.classList.remove('show'), 450);
        }}

        function playVideo(url, title, blobPath, startTime) {{
            const box = document.getElementById('playerBox');
            const player = document.getElementById('videoPlayer');
            const playerTitle = document.getElementById('playerTitle');
            const container = document.getElementById('ytContainer');

            userClosedPlayer = false;
            updateQuickResumeUI();

            currentBlobId = blobPath || url;
            let rawKey = String(url || '');
            if (rawKey.includes('/stream/play/')) {{
                rawKey = rawKey.substring(rawKey.indexOf('/stream/play/') + 13);
            }} else if (rawKey.includes('/stream/')) {{
                rawKey = rawKey.substring(rawKey.indexOf('/stream/') + 8);
            }}
            try {{ rawKey = decodeURIComponent(rawKey); }} catch (e) {{}}
            
            const fileObj = (allFiles || []).find(f => 
                f.key === rawKey || 
                f.safe_id === rawKey || 
                (f.file_names && f.file_names.includes(rawKey))
            );
            currentVideoKey = fileObj ? fileObj.key : rawKey;
            const safeId = fileObj ? fileObj.safe_id : (currentPlayingSafeId || currentVideoKey);
            currentPlayingSafeId = safeId;
            startCacheStatsPolling();

            highlightAndPromotePlayingVideo(currentVideoKey);
            playerTitle.textContent = title || "Decrypted Stream";
            box.style.display = 'block';
            resetAudioMode();
            updateSubtitleTracks(currentVideoKey);
            restorePlayerVolume();

            // Check if user is scrolled down away from main player
            const rect = box.getBoundingClientRect();
            const isScrolledDown = (window.scrollY > 180 || rect.bottom < 80 || isFloatingMini);

            if (isScrolledDown) {{
                activateFloatingMiniPlayer();
            }} else {{
                deactivateFloatingMiniPlayer();
            }}

            // Use /stream/play/ (no .mp4 extension) to completely avoid IDM capture:
            const streamPlayUrl = '/stream/play/' + encodeURIComponent(safeId);
            player.onerror = function() {{
                if (player.src && player.src.includes('/stream/play/') && currentVideoKey) {{
                    player.src = '/stream/' + encodeURIComponent(currentVideoKey);
                    player.play().catch(() => {{}});
                }}
            }};
            player.src = streamPlayUrl;

            // Target resume position or scrub seek point:
            let targetSeek = 0;
            if (typeof startTime === 'number' && startTime > 0) {{
                targetSeek = startTime;
            }} else {{
                const savedPos = getSavedVideoPosition(safeId);
                if (savedPos && savedPos.time > 5) {{
                    targetSeek = savedPos.time;
                }}
            }}

            if (targetSeek > 0) {{
                let seekDone = false;
                const applySeek = () => {{
                    if (seekDone) return;
                    try {{
                        if (player.duration && targetSeek >= player.duration - 2) {{
                            seekDone = true;
                            return;
                        }}
                        player.currentTime = targetSeek;
                        seekDone = true;
                        flashCenterFeedback(`Position: ${{formatTime(targetSeek)}}`);
                    }} catch (err) {{}}
                }};
                
                if (player.readyState >= 1) {{
                    applySeek();
                }} else {{
                    player.addEventListener('loadedmetadata', applySeek, {{ once: true }});
                    player.addEventListener('canplay', applySeek, {{ once: true }});
                }}
            }}

            player.play().catch(() => {{}});

            if (!isScrolledDown && container) {{
                container.focus();
            }}

            initYtPlayerEvents();
            loadStoryboard(url, player.duration);
            initFloatingScrollObserver();
            initMiniPlayerDraggable();
            resetControlsTimer();
        }}

        function closePlayer() {{
            const closingKey = currentVideoKey;
            const closingSafeId = currentPlayingSafeId || (currentVideoKey ? ((allFiles || []).find(f => f.key === currentVideoKey)?.safe_id || currentVideoKey) : null);
            saveLastClosedVideoSnapshot();
            captureCurrentVideoPosition();
            userClosedPlayer = true;
            deactivateFloatingMiniPlayer();
            // Stop background download / streaming and clear unpinned cache when closed
            if (closingSafeId) {{
                fetch('/api/cache/stop_playback', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ safe_id: closingSafeId, key: closingKey }})
                }}).then(() => {{
                    if (typeof updateStats === 'function') updateStats();
                }}).catch(() => {{}});
            }}
            const box = document.getElementById('playerBox');
            const player = document.getElementById('videoPlayer');
            const container = document.getElementById('ytContainer');
            if (container) {{
                container.style.left = '';
                container.style.top = '';
                container.style.bottom = '24px';
                container.style.right = '24px';
            }}
            if (document.fullscreenElement) {{
                document.exitFullscreen().catch(() => {{}});
            }}
            player.pause();
            player.src = "";
            resetAudioMode();
            setSubtitleTrack('off');
            const topMenu = document.getElementById('ytTopSubMenu');
            if (topMenu) topMenu.style.display = 'none';
            box.style.display = 'none';
            box.style.minHeight = '';
            box.classList.remove('theater-mode');
            updateQuickResumeUI();
        }}

