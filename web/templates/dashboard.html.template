            // Gather all available unique genres and tags across the entire system
            const allAvailableGenres = new Set();
            const allAvailableTags = new Set();
            allFiles.forEach(file => {{
                (file.metadata?.genres || []).forEach(g => {{
                    const strG = String(g).trim();
                    if (strG && !appliedGenres.has(strG)) allAvailableGenres.add(strG);
                }});
                (file.metadata?.tags || []).forEach(t => {{
                    const strT = String(t).trim();
                    if (strT && !appliedTags.has(strT)) allAvailableTags.add(strT);
                }});
            }});

            const input = document.getElementById('cardQuickAddInput');
            const rawQ = (input ? input.value : '').trim();
            const q = rawQ.toLowerCase();

            const showTags = (quickAddActiveFilter === 'all' || quickAddActiveFilter === 'tags');
            const showCats = (quickAddActiveFilter === 'all' || quickAddActiveFilter === 'categories');

            let matchingGenres = showCats ? Array.from(allAvailableGenres).filter(g => !q || g.toLowerCase().includes(q)).sort((a, b) => a.localeCompare(b)) : [];
            let matchingTags = showTags ? Array.from(allAvailableTags).filter(t => !q || t.toLowerCase().includes(q)).sort((a, b) => a.localeCompare(b)) : [];

            const listEl = document.getElementById('quickAddSuggestionsList');
            if (!listEl) return;

            let html = '';

            // If user typed something, show Create New Tag and Create New Category options
            if (rawQ) {{
                const existsExactTag = Array.from(appliedTags).some(t => t.toLowerCase() === q) || Array.from(allAvailableTags).some(t => t.toLowerCase() === q);
                const existsExactGenre = Array.from(appliedGenres).some(g => g.toLowerCase() === q) || Array.from(allAvailableGenres).some(g => g.toLowerCase() === q);

                html += `
                <button type="button" class="quick-add-create-btn" onclick="quickAddTagOrGenre('${{escapeHtml(key)}}', 'tag', '${{escapeHtml(rawQ)}}')">
                    <span>✨</span>
                    <span style="flex: 1; overflow: hidden; text-overflow: ellipsis;">${{existsExactTag ? 'Add Tag' : 'Create New Tag'}}: <b>"${{escapeHtml(rawQ)}}"</b></span>
                    <span class="quick-add-item-type tag-type">+ Tag</span>
                </button>
                <button type="button" class="quick-add-create-btn" onclick="quickAddTagOrGenre('${{escapeHtml(key)}}', 'genre', '${{escapeHtml(rawQ)}}')">
                    <span>📁</span>
                    <span style="flex: 1; overflow: hidden; text-overflow: ellipsis;">${{existsExactGenre ? 'Add Category' : 'Create New Category'}}: <b>"${{escapeHtml(rawQ)}}"</b></span>
                    <span class="quick-add-item-type cat-type">+ Category</span>
                </button>`;
            }}

            // Render unapplied matching categories
            matchingGenres.forEach(g => {{
                html += `
                <div class="quick-add-item" onclick="quickAddTagOrGenre('${{escapeHtml(key)}}', 'genre', '${{escapeHtml(g)}}')">
                    <span class="quick-add-item-name">
                        <span>📁</span> <span>${{escapeHtml(g)}}</span>
                    </span>
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <span class="quick-add-item-type cat-type">Category</span>
                        <span class="quick-add-item-purge" onclick="event.stopPropagation(); promptDeleteTagCategoryFromVault('genre', '${{escapeHtml(g)}}')" title="Delete category '${{escapeHtml(g)}}' permanently from vault">&times;</span>
                    </div>
                </div>`;
            }});

            // Render unapplied matching tags
            matchingTags.forEach(t => {{
                html += `
                <div class="quick-add-item" onclick="quickAddTagOrGenre('${{escapeHtml(key)}}', 'tag', '${{escapeHtml(t)}}')">
                    <span class="quick-add-item-name">
                        <span>🏷️</span> <span>${{escapeHtml(t)}}</span>
                    </span>
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <span class="quick-add-item-type tag-type">Tag</span>
                        <span class="quick-add-item-purge" onclick="event.stopPropagation(); promptDeleteTagCategoryFromVault('tag', '${{escapeHtml(t)}}')" title="Delete tag '${{escapeHtml(t)}}' permanently from vault">&times;</span>
                    </div>
                </div>`;
            }});

            if (matchingGenres.length === 0 && matchingTags.length === 0 && !rawQ) {{
                html = `<div style="padding: 16px 8px; text-align: center; color: #94a3b8; font-size: 0.75rem;">All existing tags &amp; categories are already applied!<br>Type above to create a brand new tag or category.</div>`;
            }} else if (matchingGenres.length === 0 && matchingTags.length === 0 && rawQ) {{
                html += `<div style="padding: 8px 6px; text-align: center; color: #64748b; font-size: 0.72rem; font-style: italic;">No other existing matches. Click above to create.</div>`;
            }}

            listEl.innerHTML = html;
        }}

        async function quickAddTagOrGenre(key, type, val) {{
            const clean = String(val).trim();
            if (!clean || !key) return;

            try {{
                const resp = await fetch('/api/video-tag', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ key: key, action: 'add', type: type, value: clean }})
                }});
                const res = await resp.json();
                if (res.success) {{
                    const f = allFiles.find(x => x.key === key);
                    if (f) {{
                        f.metadata = res.metadata;
                    }}
                    if (typeof FILE_CACHE !== 'undefined' && FILE_CACHE && FILE_CACHE[key]) {{
                        FILE_CACHE[key].metadata = res.metadata;
                    }}
                    updateCardBadgesDom(key);
                    populateFilterDropdowns();
                    renderQuickAddSuggestions();
                    const input = document.getElementById('cardQuickAddInput');
                    if (input) {{
                        input.value = '';
                        input.focus();
                    }}
                    showToast(`✅ Added ${{type === 'genre' ? 'Category' : 'Tag'}}: "${{clean}}"`, 'success');
                }} else {{
                    alert('Failed to add: ' + (res.message || 'Unknown error'));
                }}
            }} catch (err) {{
                alert('Request failed: ' + err);
            }}
        }}

        async function quickRemoveTagOrGenre(key, type, val) {{
            const clean = String(val).trim();
            if (!clean || !key) return;

            try {{
                const resp = await fetch('/api/video-tag', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ key: key, action: 'remove', type: type, value: clean }})
                }});
                const res = await resp.json();
                if (res.success) {{
                    const f = allFiles.find(x => x.key === key);
                    if (f) {{
                        f.metadata = res.metadata;
                    }}
                    if (typeof FILE_CACHE !== 'undefined' && FILE_CACHE && FILE_CACHE[key]) {{
                        FILE_CACHE[key].metadata = res.metadata;
                    }}
                    updateCardBadgesDom(key);
                    populateFilterDropdowns();
                    renderQuickAddSuggestions();
                    showToast(`Removed ${{type === 'genre' ? 'Category' : 'Tag'}}: "${{clean}}"`, 'info');
                }} else {{
                    alert('Failed to remove: ' + (res.message || 'Unknown error'));
                }}
            }} catch (err) {{
                alert('Request failed: ' + err);
            }}
        }}

        function updateCardBadgesDom(key) {{
            const f = allFiles.find(x => x.key === key);
            if (!f) return;
            const cards = document.querySelectorAll(`.video-card[data-key="${{CSS.escape(key)}}"]`);
            cards.forEach(card => {{
                const badgesContainer = card.querySelector('.video-card-badges');
                if (badgesContainer) {{
                    const nodeName = (card.querySelector('.video-card-sub')?.textContent || card.querySelector('.video-card-title')?.textContent || '').trim();
                    const cleanNode = nodeName.toLowerCase().endsWith('.encname') ? nodeName.trim().toLowerCase() : nodeName.replace(/\.[^/.]+$/, '').trim().toLowerCase();
                    const cleanTitle = (f.metadata?.title || '').trim().toLowerCase();
                    const allAlternativeNames = [];
                    const seenAlt = new Set([cleanTitle, cleanNode]);
                    (f.file_names || []).concat(f.aliases || []).forEach(a => {{
                        if (!a) return;
                        const baseName = a.split('/').pop().split(String.fromCharCode(92)).pop().trim();
                        const cleanA = cleanTitleExtension(baseName).toLowerCase();
                        if (cleanA && !seenAlt.has(cleanA)) {{
                            seenAlt.add(cleanA);
                            allAlternativeNames.push(baseName);
                        }}
                    }});
                    let aliasBadge = '';
                    if (allAlternativeNames.length > 0) {{
                        aliasBadge = `<div class="card-alias-cluster">` + allAlternativeNames.map(a => {{
                            const cleanA = cleanTitleExtension(a);
                            return `
                            <span class="alias-card-pill" title="Alternative filename: ${{escapeHtml(a)}}">
                                <span class="alias-card-icon">&#128206;</span>
                                <span class="alias-card-name" title="${{escapeHtml(a)}}">${{escapeHtml(a)}}</span>
                                <button type="button" class="btn-alias-direct-edit" onclick="promptEditWithTitle('${{escapeHtml(f.key)}}', '${{escapeHtml(a)}}', event)" title="Use '${{escapeHtml(cleanA)}}' as title, fix typos &amp; save">
                                    &#9998; Set as Title
                                </button>
                            </span>`;
                        }}).join('') + `</div>`;
                    }}

                    badgesContainer.innerHTML = renderCardBadgesHtml(f) + aliasBadge;
                }}
            }});
        }}

        async function promptDeleteTagCategoryFromVault(type, name) {{
            const isGenre = (type === 'genre' || type === 'category');
            const typeLabel = isGenre ? 'Category' : 'Tag';
            if (!confirm(`Permanently delete ${{typeLabel}} "${{name}}" from all videos in your entire vault?\n\nThis will remove it from all manifest records and Jellyfin .nfo files.`)) {{
                return;
            }}

            try {{
                const resp = await fetch('/api/tag-category/delete', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ type: isGenre ? 'genre' : 'tag', name: name }})
                }});
                const res = await resp.json();
                if (res.success) {{
                    showToast(res.message || `Deleted ${{typeLabel}} "${{name}}"`, 'success');
                    const targetLower = name.toLowerCase();
                    const fieldName = isGenre ? 'genres' : 'tags';
                    allFiles.forEach(f => {{
                        if (f.metadata && f.metadata[fieldName]) {{
                            f.metadata[fieldName] = f.metadata[fieldName].filter(x => String(x).trim().toLowerCase() !== targetLower);
                        }}
                    }});
                    populateFilterDropdowns();
                    refreshTreeDisplay();
                    renderQuickAddSuggestions();
                }} else {{
                    alert('Delete failed: ' + (res.message || 'Unknown error'));
                }}
            }} catch (err) {{
                alert('Request failed: ' + err);
            }}
        }}

        function promptDeleteTagGlobally(tag, event) {{
            if (event) event.stopPropagation();
            promptDeleteTagCategoryFromVault('tag', tag);
        }}

        function promptDeleteCategoryGlobally(cat, event) {{
            if (event) event.stopPropagation();
            promptDeleteTagCategoryFromVault('genre', cat);
        }}

        async function promptRenameCategoryGlobally(oldName, event) {{
            if (event) event.stopPropagation();
            const newName = prompt(`Rename Category "${{oldName}}" across all videos in vault to:`, oldName);
            if (!newName) return;
            const cleanNew = newName.trim();
            if (!cleanNew || cleanNew.toLowerCase() === oldName.toLowerCase()) return;

            try {{
                const resp = await fetch('/api/tag-category/rename', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ type: 'genre', old_name: oldName, new_name: cleanNew }})
                }});
                const res = await resp.json();
                if (res.success) {{
                    showToast(res.message || `Renamed category to "${{cleanNew}}"`, 'success');
                    const oldLower = oldName.toLowerCase();
                    allFiles.forEach(f => {{
                        if (f.metadata && f.metadata.genres) {{
                            f.metadata.genres = f.metadata.genres.map(g => (String(g).trim().toLowerCase() === oldLower ? cleanNew : g));
                        }}
                    }});
                    populateFilterDropdowns();
                    refreshTreeDisplay();
                    renderQuickAddSuggestions();
                }} else {{
                    alert('Rename failed: ' + (res.message || 'Unknown error'));
                }}
            }} catch (err) {{
                alert('Request failed: ' + err);
            }}
        }}

        async function promptRenameFolder(folderPath, currentName, count, event) {{
            if (event) event.stopPropagation();
            const promptMsg = `Rename tree folder "${{currentName}}" (${{count}} video(s)):\n\nThis updates all video paths, .strm URLs, categories, and Jellyfin .nfo files.`;
            const newName = prompt(promptMsg, currentName);
            if (!newName) return;
            const cleanNew = newName.trim().replace(/[\\\\/]/g, '').trim();
            if (!cleanNew || cleanNew.toLowerCase() === currentName.toLowerCase()) return;

            try {{
                const resp = await fetch('/api/folders/rename', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ folder_path: folderPath, new_name: cleanNew }})
                }});
                const res = await resp.json();
                if (res.success) {{
                    showToast(res.message || `Renamed folder to "${{cleanNew}}"`, 'success');
                    const oldFolder = res.old_folder || folderPath;
                    const newFolder = res.new_folder;
                    const oldPrefix = oldFolder + '/';

                    allFiles.forEach(f => {{
                        if (f.key === oldFolder || f.key.startsWith(oldPrefix)) {{
                            if (f.key === oldFolder) {{
                                f.key = newFolder;
                            }} else {{
                                f.key = newFolder + f.key.substring(oldFolder.length);
                            }}
                            if (f.file_names) {{
                                f.file_names = f.file_names.map(fn => {{
                                    if (fn === oldFolder) return newFolder;
                                    if (fn.startsWith(oldPrefix)) return newFolder + fn.substring(oldFolder.length);
                                    return fn;
                                }});
                            }}
                            if (f.metadata && f.metadata.genres) {{
                                f.metadata.genres = f.metadata.genres.map(g => (g.toLowerCase() === currentName.toLowerCase() || g.toLowerCase() === oldFolder.toLowerCase() ? (res.new_leaf || cleanNew) : g));
                            }}
                        }}
                    }});

                    if (oldFolder in folderStateStore) {{
                        folderStateStore[newFolder] = folderStateStore[oldFolder];
                        delete folderStateStore[oldFolder];
                        saveFolderStates();
                    }}

                    populateFilterDropdowns();
                    refreshTreeDisplay();
                }} else {{
                    alert('Folder rename failed: ' + (res.message || 'Unknown error'));
                }}
            }} catch (err) {{
                alert('Request failed: ' + err);
            }}
        }}

        function renderCard(f, nodeName) {{
            const meta = f.metadata || {{}};
            const title = meta.title || nodeName;
            const badgesHtml = renderCardBadgesHtml(f);

            const cleanNode = nodeName.toLowerCase().endsWith('.encname') ? nodeName.trim().toLowerCase() : nodeName.replace(/\.[^/.]+$/, '').trim().toLowerCase();
            const cleanTitle = title.trim().toLowerCase();
            const strippedNode = cleanNode.replace(/\s*\(\d+\)$/, '').trim();
            const showSubtitle = (cleanNode !== cleanTitle && strippedNode !== cleanTitle && nodeName.trim().toLowerCase() !== cleanTitle);
            const subtitleHtml = showSubtitle ? `<div class="video-card-sub" title="${{escapeHtml(nodeName)}}">${{escapeHtml(nodeName)}}</div>` : '';

            const ov = (meta.overview || "").trim();
            const isTestOv = /conflict test|dummy test|test overview/i.test(ov);
            const showOv = (ov && !isTestOv && !ov.startsWith('Encrypted vault stream:') && ov.toLowerCase() !== cleanTitle && ov.toLowerCase() !== cleanNode);
            const overviewHtml = showOv ? `<div class="card-overview-snippet" title="${{escapeHtml(ov)}}"><span style="color: #38bdf8; font-style: normal; margin-right: 4px;">&#128221; Plot:</span>${{escapeHtml(ov)}}</div>` : '';

            const accountOwner = f.account || primaryAccount;
            const isPrimary = (accountOwner === primaryAccount);
            const accountBadge = `<span class="account-pill ${{isPrimary ? 'is-primary' : ''}}" onclick="event.stopPropagation(); addQuickFilter('account', '${{escapeHtml(accountOwner)}}')" title="Click to filter by account: ${{escapeHtml(accountOwner)}}">${{isPrimary ? '&#128081;' : '&#128100;'}} ${{escapeHtml(accountOwner)}}</span>`;

            const allAlternativeNames = [];
            const seenAlt = new Set([cleanTitle, cleanNode]);
            (f.file_names || []).concat(f.aliases || []).forEach(a => {{
                if (!a) return;
                const baseName = a.split('/').pop().split(String.fromCharCode(92)).pop().trim();
                const cleanA = cleanTitleExtension(baseName).toLowerCase();
                if (cleanA && !seenAlt.has(cleanA)) {{
                    seenAlt.add(cleanA);
                    allAlternativeNames.push(baseName);
                }}
            }});
            let aliasBadge = '';
            if (allAlternativeNames.length > 0) {{
                aliasBadge = `<div class="card-alias-cluster">` + allAlternativeNames.map(a => {{
                    const cleanA = cleanTitleExtension(a);
                    return `
                    <span class="alias-card-pill" title="Alternative filename: ${{escapeHtml(a)}}">
                        <span class="alias-card-icon">&#128206;</span>
                        <span class="alias-card-name" title="${{escapeHtml(a)}}">${{escapeHtml(a)}}</span>
                        <button type="button" class="btn-alias-direct-edit" onclick="promptEditWithTitle('${{escapeHtml(f.key)}}', '${{escapeHtml(a)}}', event)" title="Use '${{escapeHtml(cleanA)}}' as title, fix typos &amp; save">
                            &#9998; Set as Title
                        </button>
                    </span>`;
                }}).join('') + `</div>`;
            }}

            const subs = f.subtitles || [];
            let subBadge = '';
            if (subs.length > 0) {{
                const subLangs = subs.map(s => (s.lang || 'cc').toUpperCase()).join(', ');
                subBadge = `<span class="meta-pill sub-pill" title="Subtitles available: ${{escapeHtml(subLangs)}}">&#128172; ${{escapeHtml(subLangs)}}</span>`;
            }}

            const safeId = f.safe_id || '';
            const hasStoryboard = !!f.has_storyboard;
            const hasScreens = !!f.has_screens;
            const canViewScreens = hasScreens || hasStoryboard;
            let thumbBgStyle = '';
            let fallbackHtml = '';
            if ((hasStoryboard || hasScreens) && safeId) {{
                const vTag = f.sb_version || (f.uploaded_at ? encodeURIComponent(f.uploaded_at) : '1');
                thumbBgStyle = "background-image: url('/api/screens/thumb?id=" + safeId + "&v=" + vTag + "'); background-size: cover; background-position: center;";
            }} else {{
                fallbackHtml = '<div class="thumb-fallback"><span class="thumb-fallback-icon">&#127916;</span><span class="thumb-fallback-txt">PREVIEW</span></div>';
            }}

            const durationStr = f.duration_str || (f.duration_sec ? formatTime(f.duration_sec) : '');
            const durationHtml = durationStr ? `<div class="card-duration-badge">${{escapeHtml(durationStr)}}</div>` : '';

            const savedPos = getSavedVideoPosition(safeId);
            let resumeBarHtml = '';
            let resumePillHtml = '';
            if (savedPos && savedPos.time > 5 && savedPos.duration > 0) {{
                const pct = Math.min(100, Math.round((savedPos.time / savedPos.duration) * 100));
                resumeBarHtml = `<div class="card-resume-bar" style="width: ${{pct}}%;"></div>`;
                resumePillHtml = `<div class="card-resume-badge" title="Resume at ${{formatTime(savedPos.time)}} / ${{formatTime(savedPos.duration)}}">⏱️ ${{formatTime(savedPos.time)}}</div>`;
            }}
            const audioSizeStr = f.audio_size_str || 'Audio';

            const cachePct = Math.round(f.cache_pct || 0);
            const cachedSizeStr = f.cached_size_str || '0 B';
            const isPinned = !!f.pinned_offline;
            const isDownloading = !!f.is_downloading;
            const isFullyOffline = isPinned && cachePct >= 99.5;
            const isProcessingOffline = (isPinned && cachePct < 99.5) || isDownloading;

            let cachePillHtml = '';
            if (isFullyOffline) {{
                cachePillHtml = `<div class="card-cache-pill is-pinned" id="cachePill_${{safeId}}" title="📌 Offline Ready: 100% saved locally forever (${{cachedSizeStr}})"><span class="cache-pill-icon">📌</span> <span class="cache-pill-text">Offline Ready</span> <span class="cache-pill-size">(${{cachedSizeStr}})</span></div>`;
            }} else if (isProcessingOffline) {{
                cachePillHtml = `<div class="card-cache-pill is-downloading" id="cachePill_${{safeId}}" title="⏳ Downloading Offline: ${{cachePct}}% (${{cachedSizeStr}}) • Saving full video locally"><span class="cache-pulse-icon">⏳</span> <span class="cache-pill-text">Downloading ${{cachePct}}%</span> <span class="cache-pill-size">(${{cachedSizeStr}})</span></div>`;
            }} else if (cachePct > 0) {{
                cachePillHtml = `<div class="card-cache-pill is-cached" id="cachePill_${{safeId}}" title="💾 Local Encrypted Cache: ${{cachePct}}% (${{cachedSizeStr}}) • Expires 24h after last play"><span class="cache-pill-icon">💾</span> <span class="cache-pill-text">${{cachePct}}%</span> <span class="cache-pill-size">(${{cachedSizeStr}})</span> <span class="cache-pill-exp">⏱️ 24h</span></div>`;
            }} else {{
                cachePillHtml = `<div class="card-cache-pill is-cloud" id="cachePill_${{safeId}}" title="☁️ Cloud Stream: 0% cached locally"><span class="cache-pill-icon">☁️</span> <span class="cache-pill-text">Cloud Stream</span></div>`;
            }}

            const cacheTrackHtml = `<div class="thumb-cache-track" title="Local Cache Buffer: ${{cachePct}}% (${{cachedSizeStr}})"><div class="thumb-cache-fill ${{isFullyOffline ? 'is-pinned-fill' : (isProcessingOffline ? 'is-downloading-fill' : '')}}" id="cacheFill_${{safeId}}" style="width: ${{Math.min(100, cachePct)}}%;"></div></div>`;

            const isMarked = markedForMergeKeys.has(f.key);
            return `
            <div class="video-card ${{isMarked ? 'is-marked-for-merge' : ''}}" data-key="${{escapeHtml(f.key)}}">
                <div class="video-card-thumb video-thumb-card" 
                     data-key="${{escapeHtml(f.key)}}" 
                     data-safeid="${{safeId}}"
                     data-duration="${{f.duration_sec || 0}}"
                     onclick="handleCardThumbClick(this, event)"
                     onmouseenter="handleThumbEnter(this)"
                     onmouseleave="handleThumbLeave(this)"
                     onmousemove="handleThumbMove(this, event)"
                     title="Click to play / resume (click bottom blue bar to play from scrub position)">
                    <div class="thumb-canvas" id="thumb-canvas-${{safeId}}" style="${{thumbBgStyle}}">
                        ${{fallbackHtml}}
                    </div>
                    <div class="thumb-screens-overlay" id="screens-overlay-${{safeId}}"></div>
                    <div class="thumb-scrub-bar" title="Click blue scrub bar to play from this position">
                        <div class="thumb-scrub-fill"></div>
                    </div>
                    <div class="thumb-overlay-play">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                    ${{canViewScreens ? `<button type="button" class="thumb-screens-btn" onmouseenter="handleScreensBtnEnter(this, event)" onmousemove="event.stopPropagation()" onmouseleave="handleScreensBtnLeave(this, event)" onclick="openScreensModal('${{safeId}}', '${{escapeHtml(title)}}', event)" title="Hover to view screens on card &bull; Click to open full sheet">&#128444;&#65039; Screens</button>` : ''}}
                    <div class="card-top-badges">
                        ${{cachePillHtml}}
                        <div class="card-size-badge" title="Video size: ${{escapeHtml(f.size_str)}} | Audio size: ${{escapeHtml(audioSizeStr)}}">
                            <span class="badge-vsize">💾 ${{escapeHtml(f.size_str)}}</span>
                            <span class="badge-sep">•</span>
                            <span class="badge-asize">🎵 ${{escapeHtml(audioSizeStr)}}</span>
                        </div>
                    </div>
                    ${{cacheTrackHtml}}
                    ${{resumePillHtml}}
                    ${{durationHtml}}
                    ${{resumeBarHtml}}
                </div>
                
                <div class="video-card-body">
                    <div class="video-card-title-row">
                        <div class="video-card-title" onclick="playVideo('/stream/${{escapeHtml(f.key)}}', '${{escapeHtml(title)}}', '${{escapeHtml(f.blob_path || '')}}')" title="Click to play: ${{escapeHtml(title)}}">
                            ${{escapeHtml(title)}}
                        </div>
                        <div class="video-card-title-actions">
                            <button type="button" class="card-offline-tag-btn ${{isFullyOffline ? 'active' : (isProcessingOffline ? 'downloading' : '')}}" id="tagOffline_${{safeId}}" onclick="toggleMakeOffline('${{safeId}}', event)" title="${{isFullyOffline ? `📌 Offline Ready (${{cachedSizeStr}}). Click to unpin.` : (isProcessingOffline ? `⏳ Downloading offline: ${{cachePct}}% (${{cachedSizeStr}}). Click to cancel.` : '📥 Make offline available (Download & save full video offline forever)')}}">
                                ${{isFullyOffline ? '📌' : (isProcessingOffline ? '<span class="cache-pulse-icon">⏳</span>' : '📥')}}
                            </button>
                            <button type="button" class="card-mark-merge-pill ${{isMarked ? 'active' : ''}}" onclick="toggleMarkForMerge('${{escapeHtml(f.key)}}', event)" title="${{isMarked ? 'Marked for duplicate merge (Click to unmark)' : 'Mark this video for duplicate merge'}}">
                                ${{isMarked ? '&#10003;' : '&#128256;'}}
                            </button>
                            <button type="button" class="card-action-arrow-btn" onclick="toggleCardActions(this, event)" title="Toggle actions (Direct, HF, Edit, Delete)">
                                <span class="card-arrow-icon">&#9662;</span>
                            </button>
                        </div>
                    </div>
                    ${{subtitleHtml}}
                    ${{overviewHtml}}
                    <div class="video-card-badges">
                        ${{badgesHtml}}
                        ${{aliasBadge}}
                    </div>
                </div>

                <div class="video-card-actions">
                    <div class="card-action-group-left">
                        <button type="button" class="card-icon-btn btn-card-offline ${{isFullyOffline ? 'is-pinned-active' : (isProcessingOffline ? 'is-downloading-active' : '')}}" id="btnOffline_${{safeId}}" onclick="toggleMakeOffline('${{safeId}}', event)" title="${{isFullyOffline ? '📌 Offline Ready (Pinned Forever). Click to unpin and allow 24h auto-expiry.' : (isProcessingOffline ? `⏳ Downloading Offline: ${{cachePct}}% (${{cachedSizeStr}}). Click to cancel.` : '📥 Make Offline Available: Download & save full video offline forever')}}">
                            ${{isFullyOffline ? '📌' : (isProcessingOffline ? '⏳' : '📥')}}
                        </button>
                        <a href="/stream/${{escapeHtml(f.key)}}" target="_blank" class="card-icon-btn btn-card-link" title="Direct Stream URL">&#128279;</a>
                        ${{canViewScreens ? `<button type="button" class="card-icon-btn" onclick="openScreensModal('${{safeId}}', '${{escapeHtml(title)}}', event)" title="View High-Res Contact Sheet Screenshots">&#128444;&#65039;</button>` : ''}}
                        <a href="/stream/audio/${{escapeHtml(f.key)}}" download="${{escapeHtml(title)}}.m4a" target="_blank" class="card-icon-btn btn-card-audio" title="Download / Stream Lightweight Audio (.m4a)">&#127925;</a>
                        <a href="${{escapeHtml(f.hf_url)}}" target="_blank" class="card-icon-btn btn-card-hf" title="Open dataset on Hugging Face">&#129303;</a>
                    </div>
                    <div class="card-action-group-right">
                        <button onclick="promptEditMetadata('${{escapeHtml(f.key)}}')" class="card-icon-btn btn-card-edit" title="Edit Tags, Categories &amp; Metadata">&#127991;</button>
                        <button onclick="promptDeleteFile('${{escapeHtml(f.key)}}')" class="card-icon-btn btn-card-delete" title="Delete Video Permanently">&#128465;</button>
                    </div>
                </div>
            </div>`;
        }}

        function renderListRow(f, nodeName) {{
            const meta = f.metadata || {{}};
            const title = meta.title || nodeName;
            const genres = meta.genres || [];
            const tags = meta.tags || [];

            let badgesHtml = '';
            if (meta.year) badgesHtml += `<span class="meta-pill year-pill">&#128197; ${{escapeHtml(meta.year)}}</span>`;
            if (meta.rating) badgesHtml += `<span class="meta-pill rating-pill">&#11088; ${{escapeHtml(meta.rating)}}</span>`;
            genres.forEach(g => {{
                badgesHtml += `<span class="meta-pill genre-pill" onclick="event.stopPropagation(); addQuickFilter('genre', '${{escapeHtml(g)}}')" title="Category / Folder: ${{escapeHtml(g)}} (Click to filter)"><span class="cat-pill-prefix">&#128193; CAT:</span><span class="cat-pill-name">${{escapeHtml(g)}}</span></span>`;
            }});
            tags.forEach(t => {{
                const tl = String(t).trim().toLowerCase();
                let cls = 'tag-pill';
                let icon = '&#127991;';
                if (tl === '4k' || tl === '2160p' || tl === 'uhd') {{ cls = 'res-4k-pill'; icon = '&#10024;'; }}
                else if (tl === '1440p' || tl === '2k' || tl === 'qhd') {{ cls = 'res-1080p-pill'; icon = '&#128250;'; }}
                else if (tl === '1080p' || tl === 'full hd' || tl === 'fhd') {{ cls = 'res-1080p-pill'; icon = '&#128250;'; }}
                else if (tl === '720p' || tl === 'hd ready' || tl === 'hd') {{ cls = 'res-720p-pill'; icon = '&#128250;'; }}
                else if (tl === '480p' || tl === 'sd') {{ cls = 'res-sd-pill'; icon = '&#128249;'; }}
                else if (tl === 'hdr' || tl === 'hdr10' || tl === 'dolby vision' || tl === 'hlg') {{ cls = 'hdr-pill'; icon = '&#127775;'; }}
                else if (tl === '5.1' || tl === '5.1 surround' || tl === '7.1' || tl === '7.1 surround' || tl === 'atmos') {{ cls = 'surround-pill'; icon = '&#128266;'; }}
                else if (['h.264', 'h.265', 'av1', 'vp9', 'hevc', 'mpeg-4'].includes(tl)) {{ cls = 'codec-pill'; icon = '&#127916;'; }}
                else if (tl.includes('< 1m') || tl.includes('1-5m') || tl === 'micro clip' || tl === 'short clip') {{ cls = 'dur-short-pill'; icon = '&#9201;'; }}
                else if (tl.includes('5-15m') || tl.includes('15-30m') || tl === 'scene' || tl === 'short form') {{ cls = 'dur-mid-pill'; icon = '&#9201;'; }}
                else if (tl.includes('30-60m') || tl === 'mid-length' || tl === 'episode') {{ cls = 'dur-mid-pill'; icon = '&#128250;'; }}
                else if (tl.includes('1-2h') || tl.includes('2-3h') || tl === 'feature film' || tl === 'extended feature') {{ cls = 'dur-long-pill'; icon = '&#127916;'; }}
                else if (tl.includes('3h+') || tl.includes('4h+') || tl.includes('epic') || tl.includes('marathon')) {{ cls = 'dur-epic-pill'; icon = '&#128293;'; }}
                else if (tl === 'cutscene' || tl === 'cinematic') {{ cls = 'cutscene-pill'; icon = '&#127918;'; }}
                else if (tl === 'trailer' || tl === 'teaser') {{ cls = 'trailer-pill'; icon = '&#127916;'; }}
                else if (tl === 'gameplay') {{ cls = 'gameplay-pill'; icon = '&#128377;'; }}
                else if (tl === 'music video') {{ cls = 'music-pill'; icon = '&#127925;'; }}
                else if (tl.includes('vertical') || tl.includes('mobile')) {{ cls = 'vertical-pill'; icon = '&#128241;'; }}
                const isHidden = hiddenTagsSet.has(t);
                badgesHtml += `
                <span class="meta-pill ${{cls}} ${{isHidden ? 'is-hidden-tag' : ''}}" title="${{isHidden ? `Hidden tag: ${{escapeHtml(t)}} (Click 👁️ to unhide)` : `Tag: ${{escapeHtml(t)}}`}}">
                    <span class="pill-label-txt" onclick="event.stopPropagation(); addQuickFilter('tag', '${{escapeHtml(t)}}')" title="Filter by tag: ${{escapeHtml(t)}}">${{icon}} ${{escapeHtml(t)}}</span>
                    <span class="pill-tag-edit" onclick="promptRenameTag('${{escapeHtml(t)}}', event)" title="Rename / edit tag '${{escapeHtml(t)}}' across all videos">&#9998;</span>
                    <span class="pill-hide-trigger" onclick="toggleHideTag('${{escapeHtml(t)}}', event)" title="${{isHidden ? 'Unhide this tag on all cards' : 'Hide this tag across all cards'}}">${{isHidden ? '&#128065;&#65039;' : '&#128584;'}}</span>
                </span>`;
            }});

            const cleanNode = nodeName.toLowerCase().endsWith('.encname') ? nodeName.trim().toLowerCase() : nodeName.replace(/\.[^/.]+$/, '').trim().toLowerCase();
            const cleanTitle = title.trim().toLowerCase();
            const showSubtitle = (cleanNode !== cleanTitle && nodeName.trim().toLowerCase() !== cleanTitle);
            const subtitleHtml = showSubtitle ? `<span style="font-size: 0.75rem; color: #6b7280; font-family: monospace;">(${{escapeHtml(nodeName)}})</span>` : '';

            const ov = (meta.overview || "").trim();
            const isTestOv = /conflict test|dummy test|test overview/i.test(ov);
            const showOv = (ov && !isTestOv && !ov.startsWith('Encrypted vault stream:') && ov.toLowerCase() !== cleanTitle && ov.toLowerCase() !== cleanNode);
            const overviewHtml = showOv ? `<div class="file-overview-snippet" title="${{escapeHtml(ov)}}"><span style="color: #38bdf8; font-style: normal; margin-right: 4px;">&#128221; Plot:</span>${{escapeHtml(ov)}}</div>` : '';

            const accountOwner = f.account || primaryAccount;
            const isPrimary = (accountOwner === primaryAccount);
            const accountBadge = `<span class="account-pill ${{isPrimary ? 'is-primary' : ''}}" onclick="event.stopPropagation(); addQuickFilter('account', '${{escapeHtml(accountOwner)}}')" title="Click to filter by account: ${{escapeHtml(accountOwner)}}">${{isPrimary ? '&#128081;' : '&#128100;'}} ${{escapeHtml(accountOwner)}}</span>`;

            const allAlternativeNames = [];
            const seenAlt = new Set([cleanTitle, cleanNode]);
            (f.file_names || []).concat(f.aliases || []).forEach(a => {{
                if (!a) return;
                const baseName = a.split('/').pop().split(String.fromCharCode(92)).pop().trim();
                const cleanA = cleanTitleExtension(baseName).toLowerCase();
                if (cleanA && !seenAlt.has(cleanA)) {{
                    seenAlt.add(cleanA);
                    allAlternativeNames.push(baseName);
                }}
            }});
            let aliasBadge = '';
            if (allAlternativeNames.length > 0) {{
                aliasBadge = `<div class="card-alias-cluster">` + allAlternativeNames.map(a => {{
                    const cleanA = cleanTitleExtension(a);
                    return `
                    <span class="alias-card-pill" title="Alternative filename: ${{escapeHtml(a)}}">
                        <span class="alias-card-icon">&#128206;</span>
                        <span class="alias-card-name" title="${{escapeHtml(a)}}">${{escapeHtml(a)}}</span>
                        <button type="button" class="btn-alias-direct-edit" onclick="promptEditWithTitle('${{escapeHtml(f.key)}}', '${{escapeHtml(a)}}', event)" title="Use '${{escapeHtml(cleanA)}}' as title, fix typos &amp; save">
                            &#9998; Set as Title
                        </button>
                    </span>`;
                }}).join('') + `</div>`;
            }}

            const subs = f.subtitles || [];
            let subBadge = '';
            if (subs.length > 0) {{
                const subLangs = subs.map(s => (s.lang || 'cc').toUpperCase()).join(', ');
                subBadge = `<span class="meta-pill sub-pill" title="Subtitles available: ${{escapeHtml(subLangs)}}">&#128172; ${{escapeHtml(subLangs)}}</span>`;
            }}

            const safeId = f.safe_id || '';
            const hasStoryboard = !!f.has_storyboard;
            const hasScreens = !!f.has_screens;
            const canViewScreens = hasScreens || hasStoryboard;
            let thumbBgStyle = '';
            let fallbackHtml = '';
            if ((hasStoryboard || hasScreens) && safeId) {{
                const vTag = f.sb_version || (f.uploaded_at ? encodeURIComponent(f.uploaded_at) : '1');
                thumbBgStyle = "background-image: url('/api/screens/thumb?id=" + safeId + "&v=" + vTag + "'); background-size: cover; background-position: center;";
            }} else {{
                fallbackHtml = '<div class="thumb-fallback"><span class="thumb-fallback-icon">&#127916;</span><span class="thumb-fallback-txt">PREVIEW</span></div>';
            }}

            const durationStr = f.duration_str || (f.duration_sec ? formatTime(f.duration_sec) : '');
            const durationHtml = durationStr ? `<div class="card-duration-badge list-duration-badge">${{escapeHtml(durationStr)}}</div>` : '';

            const savedPos = getSavedVideoPosition(safeId);
            let resumeBarHtml = '';
            let resumePillHtml = '';
            if (savedPos && savedPos.time > 5 && savedPos.duration > 0) {{
                const pct = Math.min(100, Math.round((savedPos.time / savedPos.duration) * 100));
                resumeBarHtml = `<div class="card-resume-bar" style="width: ${{pct}}%;"></div>`;
                resumePillHtml = `<div class="card-resume-badge" title="Resume at ${{formatTime(savedPos.time)}} / ${{formatTime(savedPos.duration)}}">⏱️ ${{formatTime(savedPos.time)}}</div>`;
            }}
            const audioSizeStr = f.audio_size_str || 'Audio';

            const isMarked = markedForMergeKeys.has(f.key);
            return `
            <div class="file-row ${{isMarked ? 'is-marked-for-merge' : ''}}" data-key="${{escapeHtml(f.key)}}">
                <div class="video-thumb-card" 
                     data-key="${{escapeHtml(f.key)}}" 
                     data-safeid="${{safeId}}"
                     data-duration="${{f.duration_sec || 0}}"
                     onclick="handleCardThumbClick(this, event)"
                     onmouseenter="handleThumbEnter(this)"
                     onmouseleave="handleThumbLeave(this)"
                     onmousemove="handleThumbMove(this, event)"
                     title="Click to play / resume (click bottom blue bar to play from scrub position)">
                    <div class="thumb-canvas" id="thumb-canvas-${{safeId}}" style="${{thumbBgStyle}}">
                        ${{fallbackHtml}}
                    </div>
                    <div class="thumb-screens-overlay" id="screens-overlay-list-${{safeId}}"></div>
                    <div class="thumb-scrub-bar" title="Click blue scrub bar to play from this position">
                        <div class="thumb-scrub-fill"></div>
                    </div>
                    <div class="thumb-overlay-play">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                    ${{canViewScreens ? `<button type="button" class="thumb-screens-btn" onmouseenter="handleScreensBtnEnter(this, event)" onmousemove="event.stopPropagation()" onmouseleave="handleScreensBtnLeave(this, event)" onclick="openScreensModal('${{safeId}}', '${{escapeHtml(title)}}', event)" title="Hover to view screens &bull; Click to open full sheet">&#128444;&#65039; Screens</button>` : ''}}
                    ${{resumePillHtml}}
                    ${{durationHtml}}
                    ${{resumeBarHtml}}
                </div>
                <div style="flex: 1; min-width: 0;">
                    <div style="display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;">
                        <span class="file-name" style="cursor: pointer;" onclick="playVideo('/stream/${{escapeHtml(f.key)}}', '${{escapeHtml(title)}}', '${{escapeHtml(f.blob_path || '')}}')" title="Click to play: ${{escapeHtml(title)}}">${{escapeHtml(title)}}</span>
                        ${{subtitleHtml}}
                    </div>
                    ${{overviewHtml}}
                    <div class="meta-badges">
                        ${{accountBadge}}
                        <span class="file-meta">💾 ${{f.size_str}} • 🎵 ${{audioSizeStr}}</span>
                        ${{badgesHtml}}
                        ${{aliasBadge}}
                        ${{subBadge}}
                    </div>
                </div>
                <div class="file-actions">
                    <a href="/stream/${{f.key}}" target="_blank" class="btn btn-link" title="Direct Stream URL">&#128279; Direct</a>
                    ${{canViewScreens ? `<button type="button" onclick="openScreensModal('${{safeId}}', '${{escapeHtml(title)}}', event)" class="btn btn-secondary btn-sm" title="View Full Contact Sheet Screenshots">&#128444;&#65039; Screens</button>` : ''}}
                    <a href="/stream/audio/${{f.key}}" download="${{escapeHtml(title)}}.m4a" target="_blank" class="btn btn-link btn-card-audio" title="Download / Stream Lightweight Audio (.m4a)">&#127925; Audio</a>
                    <a href="${{f.hf_url}}" target="_blank" class="btn btn-hf" title="Open file on Hugging Face">&#129303; View on HF</a>
                    <button onclick="toggleMarkForMerge('${{escapeHtml(f.key)}}', event)" class="btn btn-secondary btn-sm btn-mark-merge ${{isMarked ? 'active is-active' : ''}}" title="${{isMarked ? 'Unmark from merge' : 'Mark for duplicate merge'}}">&#128256; ${{isMarked ? 'Marked' : 'Merge'}}</button>
                    <button onclick="promptEditMetadata('${{escapeHtml(f.key)}}')" class="btn btn-edit" title="Edit tags, categories, and Jellyfin metadata">&#127991; Edit Tags</button>
                    <button onclick="promptDeleteFile('${{escapeHtml(f.key)}}')" class="btn btn-delete" title="Delete video permanently">&#128465; Delete</button>
                </div>
            </div>`;
        }}

        function getFolderFiles(folderNode) {{
            let files = [];
            if (!folderNode) return files;
            if (folderNode.type === "file") return [folderNode.data];
            if (folderNode.children) {{
                Object.values(folderNode.children).forEach(child => {{
                    files = files.concat(getFolderFiles(child));
                }});
            }}
            return files;
        }}

        function renderTree(node, depth = 0, currentPath = "") {{
            if (node.type === "file") {{
                return currentViewMode === 'card' ? renderCard(node.data, node.name) : renderListRow(node.data, node.name);
            }}

            let totalDescendantFiles = countFiles(node);
            if (totalDescendantFiles === 0 && depth > 0) return "";

            let html = "";
            const folderPath = currentPath ? `${{currentPath}}/${{node.name}}` : (depth > 0 ? node.name : "");
            const isOpen = isFolderOpen(folderPath);

            if (depth > 0) {{
                const descendantFiles = getFolderFiles(node);
                let commonTags = [];
                if (descendantFiles.length > 0) {{
                    const firstTags = (descendantFiles[0].metadata?.tags || []);
                    commonTags = firstTags.filter(t => {{
                        return descendantFiles.every(f => (f.metadata?.tags || []).includes(t));
                    }});
                }}

                const treeTagsHtml = `
                <div class="folder-tags-cluster" onclick="event.stopPropagation()">
                    ${{commonTags.map(t => `
                        <span class="tree-tag-chip" title="Tag shared by all ${{descendantFiles.length}} videos in this folder">
                            <span>${{escapeHtml(t)}}</span>
                            <span class="tree-tag-edit" onclick="promptRenameTag('${{escapeHtml(t)}}', event)" title="Rename tag '${{escapeHtml(t)}}' across all videos">&#9998;</span>
                            <span class="tree-tag-remove" onclick="removeTagFromFolder('${{escapeHtml(folderPath)}}', '${{escapeHtml(t)}}', event)" title="Remove from this folder">&times;</span>
                        </span>
                    `).join('')}}
                    <button type="button" class="btn-tree-add-tag" onclick="promptAddTagToFolder('${{escapeHtml(folderPath)}}', event)" title="Add a tag to all videos in this folder in bulk">+ Tag</button>
                </div>`;

                const cleanName = (node.name || '').trim();
                const firstChar = cleanName.charAt(0).toUpperCase();
                const letterKey = /^[A-Z]$/.test(firstChar) ? firstChar : '#';

                html += `
                <div class="folder-group ${{depth === 1 ? 'top-level-folder' : ''}}" data-folder="${{escapeHtml(folderPath)}}" data-name="${{escapeHtml(node.name)}}" data-depth="${{depth}}" data-letter="${{letterKey}}">
                    <div class="folder-header">
                        <div class="folder-left" onclick="toggleFolder(this.parentElement)">
                            <span class="folder-arrow ${{isOpen ? 'open' : ''}}">&#9654;</span>
                            <span class="folder-icon">&#128193;</span>
                            <span class="folder-name-text">${{escapeHtml(node.name)}}</span>
                            <span class="folder-count">${{totalDescendantFiles}} video(s)</span>
                            ${{treeTagsHtml}}
                        </div>
                        <div class="folder-actions">
                            <button type="button" onclick="event.stopPropagation(); openSyncFolderInExplorer('${{escapeHtml(folderPath)}}', event)" class="folder-action-icon-btn btn-sync-icon" title="Open in Local Sync Folder (videos_to_sync)">&#128194;</button>
                            <button type="button" onclick="event.stopPropagation(); openPowerRenameModal('${{escapeHtml(folderPath)}}', '${{escapeHtml(node.name)}}', event)" class="folder-action-icon-btn btn-power-rename-icon" title="Power Rename all files in this folder (Name 1, Name 2, ...)">⚡</button>
                            <button type="button" onclick="event.stopPropagation(); promptRenameFolder('${{escapeHtml(folderPath)}}', '${{escapeHtml(node.name)}}', ${{totalDescendantFiles}}, event)" class="folder-action-icon-btn btn-rename-icon" title="Rename Folder across all video paths and metadata">&#9998;</button>
                            <button type="button" onclick="event.stopPropagation(); promptDeleteFolder('${{escapeHtml(folderPath)}}', ${{totalDescendantFiles}})" class="folder-action-icon-btn btn-delete-icon" title="Delete Folder and all contained videos">&#128465;</button>
                        </div>
                    </div>
                    <div class="folder-children ${{isOpen ? '' : 'collapsed'}}">`;
            }}

            const folderChildren = [];
            const fileChildren = [];

            Object.keys(node.children).sort((a, b) => a.localeCompare(b)).forEach(k => {{
                const child = node.children[k];
                if (child.type === "folder") {{
                    folderChildren.push(child);
                }} else {{
                    fileChildren.push(child);
                }}
            }});

            // Render sub-folders first
            folderChildren.forEach(child => {{
                html += renderTree(child, depth + 1, folderPath);
            }});

            // Render direct video files inside this folder/root
            if (fileChildren.length > 0) {{
                if (currentViewMode === 'card') {{
                    html += `<div class="folder-cards-grid">`;
                    fileChildren.forEach(child => {{
                        html += renderCard(child.data, child.name);
                    }});
                    html += `</div>`;
                }} else {{
                    html += `<div class="folder-list-rows">`;
                    fileChildren.forEach(child => {{
                        html += renderListRow(child.data, child.name);
                    }});
                    html += `</div>`;
                }}
            }}

            if (depth > 0) {{
                html += `</div></div>`;
            }}

            return html;
        }}

        function countFiles(folderNode) {{
            let count = 0;
            for (const k in folderNode.children) {{
                const child = folderNode.children[k];
                if (child.type === "file") count++;
                else count += countFiles(child);
            }}
            return count;
        }}

        let selectedTags = new Set();
        let selectedGenres = new Set();
        let selectedAccounts = new Set();

        function toggleFilterPopover(popoverId, event) {{
            if (event) event.stopPropagation();
            const popover = document.getElementById(popoverId);
            if (!popover) return;
            const isOpen = popover.style.display === 'block';
            document.querySelectorAll('.filter-popover').forEach(p => p.style.display = 'none');
            if (!isOpen) {{
                popover.style.display = 'block';
                const search = popover.querySelector('.popover-search');
                if (search) {{
                    search.value = '';
                    search.focus();
                    filterPopoverList(popoverId, '');
                }}
            }}
        }}

        function filterPopoverList(popoverId, query) {{
            const popover = document.getElementById(popoverId);
            if (!popover) return;
            const q = (query || '').toLowerCase().trim();
            popover.querySelectorAll('.popover-item').forEach(item => {{
                const text = item.getAttribute('data-val') || '';
                item.style.display = (!q || text.toLowerCase().includes(q)) ? 'flex' : 'none';
            }});
        }}

        function addQuickFilter(type, val) {{
            if (!val) return;
            const clean = String(val).trim();
            if (type === 'genre') {{
                selectedGenres.add(clean);
            }} else if (type === 'tag') {{
                selectedTags.add(clean);
            }} else if (type === 'account') {{
                selectedAccounts.add(clean);
            }}
            updateFilterBadges();
            populateFilterDropdowns();
            filterTree();
            showToast(`Filter added: ${{clean}}`);
        }}

        function toggleFilterSelection(type, val) {{
            let setObj = (type === 'tag') ? selectedTags : ((type === 'genre') ? selectedGenres : selectedAccounts);
            if (setObj.has(val)) {{
                setObj.delete(val);
            }} else {{
                setObj.add(val);
            }}
            updateFilterBadges();
            filterTree();
        }}

        function selectAllFilter(type) {{
            if (type === 'tag') {{
                allFiles.forEach(f => {{
                    (f.metadata?.tags || []).forEach(t => {{ if (t) selectedTags.add(String(t).trim()); }});
                }});
            }} else if (type === 'genre') {{
                allFiles.forEach(f => {{
                    (f.metadata?.genres || []).forEach(g => {{ if (g) selectedGenres.add(String(g).trim()); }});
                }});
            }} else if (type === 'account') {{
                allFiles.forEach(f => {{
                    selectedAccounts.add(f.account || primaryAccount);
                }});
            }}
            updateFilterBadges();
            populateFilterDropdowns();
            filterTree();
        }}

        function clearFilter(type) {{
            if (type === 'tag') selectedTags.clear();
            else if (type === 'genre') selectedGenres.clear();
            else if (type === 'account') selectedAccounts.clear();
            updateFilterBadges();
            populateFilterDropdowns();
            filterTree();
        }}

        function resetAllFilters() {{
            const searchInput = document.getElementById('searchInput');
            if (searchInput) searchInput.value = '';
            selectedTags.clear();
            selectedGenres.clear();
            selectedAccounts.clear();
            updateFilterBadges();
            populateFilterDropdowns();
            filterTree();
        }}

        function updateFilterBadges() {{
            const updatePill = (btnId, badgeId, setObj) => {{
                const btn = document.getElementById(btnId);
                const badge = document.getElementById(badgeId);
                if (!btn || !badge) return;
                if (setObj.size > 0) {{
                    btn.classList.add('is-active');
                    badge.style.display = 'inline-block';
                    badge.textContent = setObj.size;
                }} else {{
                    btn.classList.remove('is-active');
                    badge.style.display = 'none';
                    badge.textContent = '0';
                }}
            }};
            updatePill('tagPillBtn', 'tagCountBadge', selectedTags);
            updatePill('genrePillBtn', 'genreCountBadge', selectedGenres);
            updatePill('accountPillBtn', 'accountCountBadge', selectedAccounts);

            const q = document.getElementById('searchInput') ? document.getElementById('searchInput').value.trim() : '';
            const totalActive = selectedTags.size + selectedGenres.size + selectedAccounts.size;
            const resetBtn = document.getElementById('btnResetFilters');
            if (resetBtn) {{
                resetBtn.style.display = (q || totalActive > 0) ? 'inline-block' : 'none';
            }}

            renderActiveFilterChips();
        }}

        function renderActiveFilterChips(matchingCount) {{
            const bar = document.getElementById('activeFilterChipsBar');
            if (!bar) return;
            const totalActive = selectedTags.size + selectedGenres.size + selectedAccounts.size;
            const q = document.getElementById('searchInput') ? document.getElementById('searchInput').value.trim() : '';
            if (totalActive === 0 && !q) {{
                bar.style.display = 'none';
                bar.innerHTML = '';
                return;
            }}
            bar.style.display = 'flex';
            const mCount = (typeof matchingCount === 'number') ? matchingCount : (window.lastMatchingCount !== undefined ? window.lastMatchingCount : allFiles.length);
            let html = `<span class="filter-count-badge">🎯 ${{mCount}} of ${{allFiles.length}} matching</span><span style="font-size: 0.74rem; color: #9ca3af; margin-right: 4px;">Active Filters:</span>`;

            if (q) {{
                html += `<span class="filter-chip">&#128269; "${{escapeHtml(q)}}" <span class="filter-chip-remove" onclick="clearSearchInput()">&times;</span></span>`;
            }}
            selectedAccounts.forEach(acc => {{
                html += `<span class="filter-chip">&#128100; ${{escapeHtml(acc)}} <span class="filter-chip-remove" onclick="toggleFilterSelection('account', '${{escapeHtml(acc)}}')">&times;</span></span>`;
            }});
            selectedGenres.forEach(g => {{
                html += `<span class="filter-chip">&#128193; ${{escapeHtml(g)}} <span class="filter-chip-remove" onclick="toggleFilterSelection('genre', '${{escapeHtml(g)}}')">&times;</span></span>`;
            }});
            selectedTags.forEach(t => {{
                html += `<span class="filter-chip">&#127991; ${{escapeHtml(t)}} <span class="filter-chip-remove" onclick="toggleFilterSelection('tag', '${{escapeHtml(t)}}')">&times;</span></span>`;
            }});
            html += `<span class="clear-all-chip" onclick="resetAllFilters()">Clear All</span>`;
            bar.innerHTML = html;
        }}

        function clearSearchInput() {{
            const el = document.getElementById('searchInput');
            if (el) {{
                el.value = '';
                filterTree();
            }}
        }}

        function populateFilterDropdowns() {{
            const accountCounts = {{}};
            const genreCounts = {{}};
            const tagCounts = {{}};

            allFiles.forEach(f => {{
                const acc = f.account || primaryAccount;
                accountCounts[acc] = (accountCounts[acc] || 0) + 1;

                const meta = f.metadata || {{}};
