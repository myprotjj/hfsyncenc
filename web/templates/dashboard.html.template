        /* Android Magnifier Bubble */
        .az-magnifier-bubble {{
            position: absolute;
            right: 36px;
            top: 50%;
            transform: translateY(-50%) scale(0.6);
            width: 48px;
            height: 48px;
            border-radius: 50% 50% 4px 50%;
