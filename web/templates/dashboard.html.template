        function cleanCurrentEditTitle() {{
            const input = document.getElementById('editTitle');
            if (input && input.value) {{
                if (input.value.toLowerCase().endsWith('.encname')) {{
                    showToast('Encrypted filename (.encname) preserved as title', 'info');
